  have bound := i.isLt
  let q : Fin 132 := ⟨i.val / 16, by omega⟩
  let r : Fin 16 := ⟨i.val % 16, by omega⟩
  have he : Fin.ofNat 2101 (q.val * 16 + r.val) = i := by
    apply Fin.ext
    change (i.val / 16 * 16 + i.val % 16) % 2101 = i.val
    omega
  exact he ▸ checkedLiftBatch q r

