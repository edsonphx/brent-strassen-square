theorem checked (i : Fin 2160) : checkAt i = true := by
  obtain ⟨⟨q, r⟩, rfl⟩ := (finProdFinEquiv (m := 270) (n := 8)).surjective i
  have hi : finProdFinEquiv (q, r) = Fin.ofNat 2160 (q.val * 8 + r.val) := by
    apply Fin.ext
    change r.val + 8 * q.val = (q.val * 8 + r.val) % 2160
    omega
  simpa only [hi] using batch q r

