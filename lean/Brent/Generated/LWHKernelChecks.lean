private theorem kerBatch (q : Fin 25) (r : Fin 8) : kerCheckAt (Fin.ofNat 200 (q.val * 8 + r.val)) = true := by
  fin_cases q
  · exact kerSteps0 r
  · exact kerSteps1 r
  · exact kerSteps2 r
  · exact kerSteps3 r
  · exact kerSteps4 r
  · exact kerSteps5 r
  · exact kerSteps6 r
  · exact kerSteps7 r
  · exact kerSteps8 r
  · exact kerSteps9 r
  · exact kerSteps10 r
  · exact kerSteps11 r
  · exact kerSteps12 r
  · exact kerSteps13 r
  · exact kerSteps14 r
  · exact kerSteps15 r
  · exact kerSteps16 r
  · exact kerSteps17 r
  · exact kerSteps18 r
  · exact kerSteps19 r
  · exact kerSteps20 r
  · exact kerSteps21 r
  · exact kerSteps22 r
  · exact kerSteps23 r
  · exact kerSteps24 r

theorem kerChecked (i : Fin 200) : kerCheckAt i = true := by
  obtain ⟨⟨q, r⟩, rfl⟩ := (finProdFinEquiv (m := 25) (n := 8)).surjective i
  have hi : finProdFinEquiv (q, r) = Fin.ofNat 200 (q.val * 8 + r.val) := by
    apply Fin.ext
    change r.val + 8 * q.val = (q.val * 8 + r.val) % 200
    omega
  simpa only [hi] using kerBatch q r

end Brent.LWH
