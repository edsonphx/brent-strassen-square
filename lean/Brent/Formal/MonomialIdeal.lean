import Mathlib.RingTheory.MvPowerSeries.Rename
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Setting variables to zero

For an embedding `e : σ ↪ τ` of finite index types, the map `killCompl e` sets the variables
outside the image of `e` to zero. Its kernel is the ideal generated by those variables. Hence
`k⟦τ⟧ ⧸ (X_t : t ∉ range e) ≃ k⟦σ⟧`.
-/

open scoped BigOperators

namespace Brent.Formal

open MvPowerSeries Finsupp

variable {σ τ : Type*} {k : Type*} [CommRing k]

/-- The part of `f` without the variable `i`. -/
noncomputable def dropVar (i : τ) (f : MvPowerSeries τ k) : MvPowerSeries τ k :=
  fun m => if m i = 0 then coeff m f else 0

theorem coeff_dropVar (i : τ) (f : MvPowerSeries τ k) (m : τ →₀ ℕ) :
    coeff m (dropVar i f) = if m i = 0 then coeff m f else 0 := rfl

theorem X_dvd_sub_dropVar (i : τ) (f : MvPowerSeries τ k) : X i ∣ f - dropVar i f := by
  rw [X_dvd_iff]
  intro m hm
  rw [map_sub, coeff_dropVar, if_pos hm, sub_self]

/-- A power series with no monomial avoiding all variables of `T` lies in the ideal
generated by those variables. -/
theorem mem_span_X_of_coeff (T : Finset τ) (f : MvPowerSeries τ k)
    (hf : ∀ m : τ →₀ ℕ, (∀ i ∈ T, m i = 0) → coeff m f = 0) :
    f ∈ Ideal.span (X '' (T : Set τ)) := by
  classical
  induction T using Finset.induction_on generalizing f with
  | empty =>
    have : f = 0 := MvPowerSeries.ext fun m => by simpa using hf m (by simp)
    rw [this]
    exact Ideal.zero_mem _
  | insert i T hi ih =>
    have hr : dropVar i f ∈ Ideal.span (X '' (T : Set τ)) := by
      refine ih _ fun m hm => ?_
      rw [coeff_dropVar]
      split_ifs with h
      · refine hf m fun j hj => ?_
        rcases Finset.mem_insert.mp hj with rfl | hj
        · exact h
        · exact hm j hj
      · rfl
    obtain ⟨q, hq⟩ := X_dvd_sub_dropVar i f
    have hsplit : f = X i * q + dropVar i f := by rw [← hq, sub_add_cancel]
    rw [hsplit]
    refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, by simp, rfl⟩)) ?_
    exact Ideal.span_mono (Set.image_mono (by simp)) hr

variable (e : σ ↪ τ)

/-- **Kernel of setting variables to zero.** -/
theorem ker_killCompl [Fintype τ] :
    RingHom.ker (killCompl (R := k) e).toRingHom =
      Ideal.span (X '' (Set.range e)ᶜ) := by
  classical
  apply le_antisymm
  · intro f hf
    have hf' : killCompl e f = 0 := hf
    have hcoe : ((Finset.univ.filter fun t => t ∉ Set.range e : Finset τ) : Set τ) =
        (Set.range e)ᶜ := by ext; simp
    rw [← hcoe]
    refine mem_span_X_of_coeff _ f fun m hm => ?_
    have hsupp : (m.support : Set τ) ⊆ Set.range e := by
      intro t ht
      by_contra hnot
      exact (Finsupp.mem_support_iff.mp ht) (hm t (by simpa using hnot))
    rw [← embDomain_comapDomain hsupp, ← coeff_killCompl, hf', map_zero]
  · rw [Ideal.span_le]
    rintro _ ⟨t, ht, rfl⟩
    exact killCompl_X_eq_zero ht

theorem killCompl_surjective : Function.Surjective (killCompl (R := k) e) :=
  fun p => ⟨rename e p, killCompl_rename_app p⟩

/-- `k⟦τ⟧ ⧸ (X_t : t ∉ range e) ≃ k⟦σ⟧`. -/
noncomputable def quotientKillEquiv [Fintype τ] :
    (MvPowerSeries τ k ⧸ Ideal.span (X '' (Set.range e)ᶜ : Set (MvPowerSeries τ k))) ≃+*
      MvPowerSeries σ k :=
  (Ideal.quotEquivOfEq (ker_killCompl e).symm).trans
    (RingHom.quotientKerEquivOfSurjective (f := (killCompl (R := k) e).toRingHom)
      (killCompl_surjective e))

end Brent.Formal
