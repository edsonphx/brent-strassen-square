import Brent.Formal.MonomialIdeal
import Brent.Formal.PowerSeriesNoetherian
import Brent.LocalDimension
import Mathlib.RingTheory.MvPowerSeries.NoZeroDivisors
import Mathlib.RingTheory.MvPowerSeries.Inverse
import Mathlib.RingTheory.Spectrum.Prime.RingHom

/-!
# Krull dimension of `k⟦σ⟧`

For a finite `σ` and a field `k`, `dim k⟦σ⟧ = |σ|`. The chain of variable ideals
`0 ⊂ (X₀) ⊂ (X₀, X₁) ⊂ ⋯` gives `≥`. Their quotients are power series rings, hence domains.
The maximal ideal is generated by the `|σ|` variables, so the height theorem gives `≤`.

Also: if `R → S` is surjective onto a domain carrying a prime chain of length `n` from `0`,
and `dim R ≤ n`, then the kernel is a minimal prime of `R`.
-/

open scoped BigOperators

namespace Brent.Formal

open MvPowerSeries IsLocalRing

variable {σ : Type} {k : Type} [Field k]

instance : IsDomain (MvPowerSeries σ k) := NoZeroDivisors.to_isDomain _

theorem X_ne_zero' (s : σ) : (X s : MvPowerSeries σ k) ≠ 0 := by
  intro h
  have := congrArg (coeff (Finsupp.single s 1)) h
  simp at this

/-- The ideal generated by a set of variables. -/
noncomputable def varIdeal (T : Set σ) : Ideal (MvPowerSeries σ k) := Ideal.span (X '' T)

/-- Setting the variables of `T` to zero. -/
noncomputable def killSet (T : Set σ) :
    MvPowerSeries σ k →+* MvPowerSeries {s // s ∉ T} k :=
  (killCompl (R := k) (Function.Embedding.subtype (· ∉ T))).toRingHom

theorem varIdeal_eq_ker [Fintype σ] (T : Set σ) :
    (varIdeal T : Ideal (MvPowerSeries σ k)) = RingHom.ker (killSet T) := by
  rw [killSet, ker_killCompl, varIdeal]
  congr 2
  ext s
  simp

instance varIdeal_isPrime [Fintype σ] (T : Set σ) : (varIdeal T : Ideal (MvPowerSeries σ k)).IsPrime := by
  rw [varIdeal_eq_ker]
  exact RingHom.ker_isPrime _

theorem X_not_mem_varIdeal [Fintype σ] {T : Set σ} {t : σ} (ht : t ∉ T) :
    (X t : MvPowerSeries σ k) ∉ varIdeal T := by
  rw [varIdeal_eq_ker, RingHom.mem_ker]
  have h := killCompl_X (R := k) (e := Function.Embedding.subtype (· ∉ T)) ⟨t, ht⟩
  simp only [Function.Embedding.coe_subtype] at h
  change killCompl _ (X t) ≠ 0
  rw [h]
  exact X_ne_zero' _

theorem varIdeal_lt [Fintype σ] {T T' : Set σ} (h : T ⊆ T') {t : σ} (ht : t ∈ T') (ht' : t ∉ T) :
    (varIdeal T : Ideal (MvPowerSeries σ k)) < varIdeal T' := by
  refine lt_of_le_of_ne (Ideal.span_mono (Set.image_mono h)) fun heq => ?_
  apply X_not_mem_varIdeal (k := k) ht'
  rw [heq]
  exact Ideal.subset_span ⟨t, ht, rfl⟩

variable (σ k)

/-- The chain of variable ideals. -/
noncomputable def varChain [Fintype σ] : LTSeries (PrimeSpectrum (MvPowerSeries σ k)) :=
  LTSeries.mk (Fintype.card σ)
    (fun i => ⟨varIdeal {s | (Fintype.equivFin σ s).val < i.val}, inferInstance⟩)
    (by
      apply Fin.strictMono_iff_lt_succ.mpr
      intro i
      change varIdeal _ < varIdeal _
      refine varIdeal_lt (t := (Fintype.equivFin σ).symm i) ?_ ?_ ?_
      · intro s hs
        simp only [Set.mem_setOf_eq, Fin.val_castSucc, Fin.val_succ] at hs ⊢
        omega
      · simp
      · simp)

theorem varChain_length [Fintype σ] : (varChain σ k).length = Fintype.card σ := rfl

theorem varChain_head [Fintype σ] : (varChain σ k).head.asIdeal = ⊥ := by
  change varIdeal _ = ⊥
  rw [varIdeal, Ideal.span_eq_bot]
  rintro _ ⟨s, hs, rfl⟩
  simp at hs

theorem card_le_ringKrullDim [Fintype σ] :
    (Fintype.card σ : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries σ k) :=
  Order.LTSeries.length_le_krullDim (varChain σ k)

theorem maximalIdeal_le_span_X [Fintype σ] :
    maximalIdeal (MvPowerSeries σ k) ≤ Ideal.span (Set.range (X : σ → MvPowerSeries σ k)) := by
  intro f hf
  have h0 : constantCoeff f = 0 := by
    by_contra h
    exact hf (isUnit_iff_constantCoeff.mpr (Ne.isUnit h))
  have := mem_span_X_of_coeff (Finset.univ : Finset σ) f fun m hm => by
    have : m = 0 := Finsupp.ext fun i => hm i (Finset.mem_univ i)
    rw [this, coeff_zero_eq_constantCoeff_apply, h0]
  rwa [Finset.coe_univ, Set.image_univ] at this

theorem ringKrullDim_le_card [Fintype σ] :
    ringKrullDim (MvPowerSeries σ k) ≤ Fintype.card σ := by
  let f : Fin (Fintype.card σ) → MvPowerSeries σ k := fun i => X ((Fintype.equivFin σ).symm i)
  have hf : ∀ i, f i ∈ maximalIdeal (MvPowerSeries σ k) := fun i => by
    rw [mem_maximalIdeal, mem_nonunits_iff, isUnit_iff_constantCoeff]
    simp [f]
  refine localDimension_le_of_power_le_span_sup_pow f hf (d := 1) one_ne_zero ?_
  rw [pow_one]
  refine (maximalIdeal_le_span_X σ k).trans (le_sup_of_le_left (Ideal.span_mono ?_))
  rintro _ ⟨s, rfl⟩
  exact ⟨Fintype.equivFin σ s, by simp [f]⟩

/-- **`dim k⟦σ⟧ = |σ|`.** -/
theorem ringKrullDim_mvPowerSeries [Fintype σ] :
    ringKrullDim (MvPowerSeries σ k) = Fintype.card σ :=
  le_antisymm (ringKrullDim_le_card σ k) (card_le_ringKrullDim σ k)

variable {σ k}

/-- **Minimality from a dimension count.** -/
theorem ker_mem_minimalPrimes {R S : Type} [CommRing R] [CommRing S] [IsDomain S]
    (f : R →+* S) (hf : Function.Surjective f) (c : LTSeries (PrimeSpectrum S))
    (hc : c.head.asIdeal = ⊥) (hR : ringKrullDim R ≤ c.length) :
    RingHom.ker f ∈ minimalPrimes R := by
  refine ⟨⟨RingHom.ker_isPrime f, bot_le⟩, fun q hq hle => ?_⟩
  by_contra hnot
  have hlt : q < RingHom.ker f := lt_of_le_of_ne hle fun h => hnot (h ▸ le_refl _)
  have hmono : StrictMono (PrimeSpectrum.comap f) :=
    Monotone.strictMono_of_injective (fun a b h => Ideal.comap_mono h)
      (PrimeSpectrum.comap_injective_of_surjective f hf)
  let c' := c.map (PrimeSpectrum.comap f) hmono
  have hhead : c'.head.asIdeal = RingHom.ker f := by
    simp only [c', LTSeries.head_map, PrimeSpectrum.comap_asIdeal, hc]
    rfl
  let q' : PrimeSpectrum R := ⟨q, hq.1⟩
  have hq' : q' < c'.head := by
    change q < c'.head.asIdeal
    rw [hhead]
    exact hlt
  have hlen := Order.LTSeries.length_le_krullDim (c'.cons q' hq')
  rw [RelSeries.cons_length] at hlen
  have := hlen.trans hR
  simp only [c', LTSeries.map_length] at this
  norm_cast at this
  omega

end Brent.Formal
