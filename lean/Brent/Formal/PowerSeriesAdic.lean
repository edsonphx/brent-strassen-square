import Brent.Formal.FormalInverse
import Brent.Formal.MonomialIdeal
import Mathlib.RingTheory.MvPowerSeries.Trunc
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# The adic topology of `k⟦σ⟧`

For finite `σ`, the `n`-th power of the ideal `(X)` of the variables is exactly the ideal of
series with no terms of total degree below `n`. Hence `(X)`-adic Cauchy sequences converge
(coefficientwise), and every series agrees with a polynomial modulo `(X)ⁿ`.
-/

open scoped BigOperators

namespace Brent.Formal

open MvPowerSeries Finsupp

variable {σ : Type*} {k : Type*} [CommRing k]

variable (σ k) in
/-- The ideal generated by the variables. -/
noncomputable def mX : Ideal (MvPowerSeries σ k) := Ideal.span (Set.range X)

variable (σ k) in
/-- The ideal of series with no terms below total degree `n`. -/
noncomputable def lowIdeal (n : ℕ) : Ideal (MvPowerSeries σ k) where
  carrier := {f | LowZero n f}
  add_mem' := LowZero.add
  zero_mem' := LowZero.zero n
  smul_mem' c f hf := by
    have := LowZero.mul (LowZero.of_zero c) hf
    rw [zero_add] at this
    exact this

theorem mem_lowIdeal {n : ℕ} {f : MvPowerSeries σ k} : f ∈ lowIdeal σ k n ↔ LowZero n f := Iff.rfl

/-- `(X)ⁿ` vanishes below degree `n`. -/
theorem lowZero_of_mem_pow : ∀ (n : ℕ) {f : MvPowerSeries σ k}, f ∈ mX σ k ^ n → LowZero n f
  | 0, f, _ => LowZero.of_zero f
  | n + 1, f, hf => by
    have hX : mX σ k ≤ lowIdeal σ k 1 := by
      rw [mX, Ideal.span_le]
      rintro _ ⟨s, rfl⟩
      exact LowZero.one_X s
    have hle : mX σ k ^ (n + 1) ≤ lowIdeal σ k (n + 1) := by
      rw [pow_succ, Ideal.mul_le]
      intro a ha b hb
      exact LowZero.mul (lowZero_of_mem_pow n ha) (hX hb)
    exact hle hf

/-- Series vanishing below degree `n` lie in `(X)ⁿ`. -/
theorem mem_pow_of_lowZero [Fintype σ] :
    ∀ (n : ℕ) (f : MvPowerSeries σ k), LowZero n f → f ∈ mX σ k ^ n
  | 0, f, _ => by simp
  | n + 1, f, hf => by
    classical
    suffices H : ∀ (T : Finset σ) (f : MvPowerSeries σ k), LowZero (n + 1) f →
        (∀ m : σ →₀ ℕ, (∀ i ∈ T, m i = 0) → coeff m f = 0) → f ∈ mX σ k ^ (n + 1) by
      refine H Finset.univ f hf fun m hm => ?_
      have : m = 0 := Finsupp.ext fun i => hm i (Finset.mem_univ i)
      subst this
      exact hf 0 (by simp)
    intro T
    induction T using Finset.induction_on with
    | empty =>
      intro f _ h0
      have : f = 0 := MvPowerSeries.ext fun m => by simpa using h0 m (by simp)
      rw [this]
      exact Ideal.zero_mem _
    | insert i T hi ih =>
      intro f hf hT
      obtain ⟨q, hq⟩ := X_dvd_sub_dropVar i f
      have hq' : LowZero n q := by
        intro m hm
        have h := congrArg (coeff (single i 1 + m)) hq
        rw [X, coeff_add_monomial_mul, one_mul, map_sub, coeff_dropVar] at h
        rw [← h]
        have hdeg : (single i 1 + m).degree < n + 1 := by
          rw [map_add, degree_single]
          omega
        rw [hf _ hdeg]
        split_ifs <;> simp
      have hdrop : LowZero (n + 1) (dropVar i f) := by
        intro m hm
        rw [coeff_dropVar]
        split_ifs
        · exact hf m hm
        · rfl
      have hd : dropVar i f ∈ mX σ k ^ (n + 1) := by
        refine ih _ hdrop fun m hm => ?_
        rw [coeff_dropVar]
        split_ifs with h
        · refine hT m fun j hj => ?_
          rcases Finset.mem_insert.mp hj with rfl | hj
          · exact h
          · exact hm j hj
        · rfl
      have hsplit : f = X i * q + dropVar i f := by rw [← hq, sub_add_cancel]
      rw [hsplit]
      refine add_mem ?_ hd
      rw [pow_succ']
      exact Ideal.mul_mem_mul (Ideal.subset_span ⟨i, rfl⟩) (mem_pow_of_lowZero n q hq')

theorem mem_pow_iff_lowZero [Fintype σ] (n : ℕ) (f : MvPowerSeries σ k) :
    f ∈ mX σ k ^ n ↔ LowZero n f :=
  ⟨lowZero_of_mem_pow n, mem_pow_of_lowZero n f⟩

/-- **Adic limits.** -/
theorem exists_limit [Fintype σ] (F : ℕ → MvPowerSeries σ k)
    (hF : ∀ n, F (n + 1) - F n ∈ mX σ k ^ n) : ∃ L, ∀ n, L - F n ∈ mX σ k ^ n := by
  have hcauchy : ∀ n j, n ≤ j → F j - F n ∈ mX σ k ^ n := by
    intro n j hj
    induction j, hj using Nat.le_induction with
    | base => rw [sub_self]; exact Ideal.zero_mem _
    | succ j hj ih =>
      have := Ideal.pow_le_pow_right hj (hF j)
      rw [show F (j + 1) - F n = (F (j + 1) - F j) + (F j - F n) by ring]
      exact add_mem this ih
  let L : MvPowerSeries σ k := fun e => coeff e (F (e.degree + 1))
  refine ⟨L, fun n => mem_pow_of_lowZero n _ fun e he => ?_⟩
  have h := lowZero_of_mem_pow _ (hcauchy (e.degree + 1) n (by omega)) e (by omega)
  rw [map_sub] at h ⊢
  rw [sub_eq_zero] at h ⊢
  exact h.symm

/-- The box of exponents bounded by `n` in every variable. -/
noncomputable def box [Fintype σ] (n : ℕ) : σ →₀ ℕ := equivFunOnFinite.symm fun _ => n

theorem le_box [Fintype σ] {n : ℕ} {e : σ →₀ ℕ} (he : e.degree < n) : e ≤ box n := by
  intro i
  have : (box n : σ →₀ ℕ) i = n := by simp [box]
  rw [this]
  exact (le_degree i e).trans he.le

/-- **Truncation.** Every series agrees with a polynomial modulo `(X)ⁿ`. -/
theorem sub_trunc_mem [Fintype σ] [DecidableEq σ] (n : ℕ) (f : MvPowerSeries σ k) :
    f - ((trunc' k (box n) f : MvPolynomial σ k) : MvPowerSeries σ k) ∈ mX σ k ^ n := by
  refine mem_pow_of_lowZero n _ fun e he => ?_
  rw [map_sub, MvPolynomial.coeff_coe, coeff_trunc', if_pos (le_box he), sub_self]

/-- A polynomial in `(X)ⁿ` of the power series ring is in `(X)ⁿ` of the polynomial ring. -/
theorem mem_pow_idealOfVars_of_coe [Fintype σ] {n : ℕ} {p : MvPolynomial σ k}
    (hp : (p : MvPowerSeries σ k) ∈ mX σ k ^ n) : p ∈ MvPolynomial.idealOfVars σ k ^ n := by
  rw [MvPolynomial.mem_pow_idealOfVars_iff']
  intro e he
  have := lowZero_of_mem_pow n hp e he
  rwa [MvPolynomial.coeff_coe] at this

end Brent.Formal
