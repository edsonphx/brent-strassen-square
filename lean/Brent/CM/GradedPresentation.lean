import Brent.CM.Lemma41
import Brent.InitialForms

/-! The graded-piece isomorphism for the ideal generated by the regular initial
forms, complementing the graded surjection used in Lemma 4.1. This does not yet
assemble the degreewise equivalences into a graded ring equivalence. -/
namespace Brent.CM

open IsLocalRing InitialForms

variable {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
local notation "𝔪" => maximalIdeal A

variable (f : ℕ → A) (d : ℕ → ℕ) (hf : ∀ i, f i ∈ 𝔪 ^ d i)
  (hreg : ∀ i, InitialRegularRel 𝔪 (firstIdeal f i) (f i) (d i))

/-- Every element of the relation ideal of order at least `n` has the expected
initial relation in degree `n`. -/
theorem firstIdeal_inf_pow_le_relI (s n : ℕ) :
    firstIdeal f s ⊓ 𝔪 ^ n ≤ relI f d s n := by
  induction s with
  | zero =>
    rw [firstIdeal_zero, bot_inf_eq]
    exact bot_le
  | succ s ih =>
    intro x hx
    have hj : x ∈ Ideal.span ({f s} : Set A) ⊔ firstIdeal f s := by
      rw [← firstIdeal_succ]
      exact hx.1
    have hn : x ∈ 𝔪 ^ n := hx.2
    by_cases h : d s ≤ n
    · have hm : x ∈ 𝔪 ^ ((n - d s) + d s) ⊔ firstIdeal f s := by
        rw [Nat.sub_add_cancel h]
        exact Ideal.mem_sup_left hn
      obtain ⟨p, hp, y, hy, he⟩ := Submodule.mem_sup.mp
        (mem_inf_rel 𝔪 (firstIdeal f s) (f s) (d s) (n - d s) (hreg s) hj hm)
      have hp' : p ∈ 𝔪 ^ n := by
        have hle : Ideal.span ({f s} : Set A) * 𝔪 ^ (n - d s) ≤ 𝔪 ^ n := by
          calc
            _ ≤ 𝔪 ^ d s * 𝔪 ^ (n - d s) :=
              Ideal.mul_mono_left ((Ideal.span_singleton_le_iff_mem _).mpr (hf s))
            _ = 𝔪 ^ n := by rw [← pow_add, Nat.add_sub_of_le h]
        exact hle hp
      have hy' : y ∈ 𝔪 ^ n := by
        have hh := Ideal.sub_mem _ hn hp'
        rw [← he, add_sub_cancel_left] at hh
        exact hh
      rw [← he, relI, if_pos h]
      exact Ideal.add_mem _ (Ideal.mem_sup_right hp) (Ideal.mem_sup_left (ih ⟨hy, hy'⟩))
    · obtain ⟨p, hp, y, hy, he⟩ := Submodule.mem_sup.mp hj
      have hp' : p ∈ 𝔪 ^ (n + 1) :=
        (Ideal.pow_le_pow_right (by omega : n + 1 ≤ d s))
          (((Ideal.span_singleton_le_iff_mem _).mpr (hf s)) hp)
      have hp'' : p ∈ 𝔪 ^ n := Ideal.pow_le_pow_right (Nat.le_succ n) hp'
      have hy' : y ∈ 𝔪 ^ n := by
        have hh := Ideal.sub_mem _ hn hp''
        rw [← he, add_sub_cancel_left] at hh
        exact hh
      rw [← he, relI, if_neg h, sup_bot_eq]
      exact Ideal.add_mem _ (pow_succ_le_relI f d s n hp') (ih ⟨hy, hy'⟩)

/-- The canonical quotient map on degree `n` is injective when the ideal is
exactly the ideal generated by the chosen relations. -/
theorem toGr_firstIdeal_injective (s n : ℕ) :
    Function.Injective (toGr f d hf (I := firstIdeal f s) (s := s)
      (fun j hj => Ideal.subset_span ⟨j, hj, rfl⟩) n) := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro q hq
  induction q using Submodule.Quotient.induction_on with
  | H b =>
    rw [LinearMap.mem_ker, toGr, Submodule.mapQ_apply, Submodule.Quotient.mk_eq_zero] at hq
    change (b : A) ∈ firstIdeal f s ⊔ 𝔪 ^ (n + 1) at hq
    obtain ⟨j, hj, c, hc, he⟩ := Submodule.mem_sup.mp hq
    have hc' : c ∈ 𝔪 ^ n := Ideal.pow_le_pow_right (Nat.le_succ n) hc
    have hj' : j ∈ 𝔪 ^ n := by
      have hh := Ideal.sub_mem _ b.2 hc'
      rw [← he, add_sub_cancel_right] at hh
      exact hh
    rw [Submodule.mem_bot, Submodule.Quotient.mk_eq_zero]
    change (b : A) ∈ relI f d s n
    rw [← he]
    exact Ideal.add_mem _ (firstIdeal_inf_pow_le_relI f d hf hreg s n ⟨hj, hj'⟩)
      (pow_succ_le_relI f d s n hc)

/-- Degreewise presentation of the associated graded quotient. -/
noncomputable def lemma41_gradedPieceEquiv (s n : ℕ) :
    RPiece f d s n ≃ₗ[A] grFam (firstIdeal f s) n :=
  LinearEquiv.ofBijective _ ⟨toGr_firstIdeal_injective f d hf hreg s n,
    toGr_surjective f d hf (fun j hj => Ideal.subset_span ⟨j, hj, rfl⟩) n⟩

end Brent.CM
