import Brent.CM.GradedRingAssembly
import Brent.CM.PowerSeriesInstance

/-! Source draft: identify the assembled relation presentation with the actual
quotient by the homogeneous initial-form ideal. The last section specializes
this to a formal power series ring over a field. -/
namespace Brent.CM.GradedRingAssembly

open IsLocalRing InitialForms
open scoped DirectSum BigOperators

variable {A : Type*} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
local notation "𝔪" => maximalIdeal A
variable (f : ℕ → A) (d : ℕ → ℕ)

abbrev GrBase := ⨁ n, Piece (source f d 0) n
abbrev GrSource (s : ℕ) := ⨁ n, Piece (source f d s) n

noncomputable def projectionPiece (s n : ℕ) :
    Piece (source f d 0) n →ₗ[A] Piece (source f d s) n :=
  Submodule.mapQ _ _ LinearMap.id (fun a ha => pow_succ_le_relI (f := f) (d := d) s n ha)

@[simp] theorem projectionPiece_mk (s n : ℕ) (a : 𝔪 ^ n) :
    projectionPiece f d s n (mk (source f d 0) n a) = mk (source f d s) n a := rfl

noncomputable def projection (s : ℕ) : GrBase f d →+* GrSource f d s :=
  DirectSum.toSemiring
    (fun n => (DirectSum.of _ n).comp (projectionPiece f d s n).toAddMonoidHom)
    (by rfl)
    (by
      intro i j a b
      induction a using piece_induction (source f d 0) with
      | h a =>
        induction b using piece_induction (source f d 0) with
        | h b =>
          change DirectSum.of _ (i+j) (projectionPiece f d s (i+j)
            (product (source f d 0) i j (mk (source f d 0) i a) (mk (source f d 0) j b))) =
            DirectSum.of _ i (projectionPiece f d s i (mk (source f d 0) i a)) *
            DirectSum.of _ j (projectionPiece f d s j (mk (source f d 0) j b))
          rw [DirectSum.of_mul_of]
          simp only [projectionPiece_mk, product_mk]
          rfl)

@[simp] theorem projection_of (s n : ℕ) (a : Piece (source f d 0) n) :
    projection f d s (DirectSum.of _ n a) = DirectSum.of _ n (projectionPiece f d s n a) :=
  DirectSum.toSemiring_of _ _ _ n a

theorem projection_toAddMonoidHom (s : ℕ) : (projection f d s).toAddMonoidHom =
    DirectSum.map (fun n => (projectionPiece f d s n).toAddMonoidHom) := by
  apply DirectSum.addHom_ext
  intro n a
  change projection f d s (DirectSum.of _ n a) = _
  rw [projection_of, DirectSum.map_of]
  rfl

theorem projection_apply (s n : ℕ) (a : GrBase f d) :
    projection f d s a n = projectionPiece f d s n (a n) := by
  change (projection f d s).toAddMonoidHom a n = _
  rw [projection_toAddMonoidHom, DirectSum.map_apply]
  rfl

theorem projection_surjective (s : ℕ) : Function.Surjective (projection f d s) := by
  change Function.Surjective (projection f d s).toAddMonoidHom
  rw [projection_toAddMonoidHom, DirectSum.map_surjective]
  intro n a
  induction a using piece_induction (source f d s) with
  | h a => exact ⟨mk (source f d 0) n a, projectionPiece_mk f d s n a⟩

variable (hf : ∀ i, f i ∈ 𝔪 ^ d i)

/-- The homogeneous element represented by the series `f_i` in degree `d_i`. -/
noncomputable def initialGenerator (i : ℕ) : GrBase f d :=
  DirectSum.of _ (d i) (mk (source f d 0) (d i) ⟨f i, hf i⟩)

noncomputable def initialIdeal (s : ℕ) : Ideal (GrBase f d) :=
  Ideal.span (Set.range fun i : Fin s => initialGenerator f d hf i)

theorem initialIdeal_mono (s : ℕ) : initialIdeal f d hf s ≤ initialIdeal f d hf (s+1) := by
  apply Ideal.span_mono
  rintro _ ⟨i,rfl⟩
  exact ⟨⟨i.val, by omega⟩, rfl⟩

/-- Every homogeneous relation comes from the ideal generated by the initial
forms, not an additional unidentified degreewise relation. -/
theorem relI_mem_initialIdeal (s n : ℕ) (a : 𝔪 ^ n)
    (ha : a.val ∈ relI f d s n) :
    DirectSum.of _ n (mk (source f d 0) n a) ∈ initialIdeal f d hf s := by
  induction s generalizing a with
  | zero =>
    have h0 : mk (source f d 0) n a = 0 := Submodule.Quotient.mk_eq_zero.mpr ha
    rw [h0, map_zero]
    exact Ideal.zero_mem _
  | succ s ih =>
    change a.val ∈ relI f d s n ⊔ (if d s ≤ n then Ideal.span {f s} * 𝔪 ^ (n - d s) else ⊥) at ha
    obtain ⟨u, hu, v, hv, he⟩ := Submodule.mem_sup.mp ha
    have hu' : u ∈ 𝔪 ^ n := relI_le_pow hf s n hu
    have hv' : v ∈ 𝔪 ^ n := relI_le_pow hf (s+1) n (Ideal.mem_sup_right hv)
    let U : 𝔪 ^ n := ⟨u,hu'⟩
    let V : 𝔪 ^ n := ⟨v,hv'⟩
    have ha' : a = U + V := Subtype.ext he.symm
    rw [ha']
    change DirectSum.of _ n (Submodule.Quotient.mk (U + V)) ∈ _
    rw [Submodule.Quotient.mk_add, map_add]
    apply Ideal.add_mem _ (initialIdeal_mono f d hf s (ih U hu))
    by_cases hd : d s ≤ n
    · rw [if_pos hd] at hv
      obtain ⟨b,hb,hvb⟩ := Ideal.mem_span_singleton_mul.mp hv
      let B : 𝔪 ^ (n - d s) := ⟨b,hb⟩
      have hprod : initialGenerator f d hf s * DirectSum.of _ (n - d s)
          (mk (source f d 0) (n - d s) B) =
          DirectSum.of _ n (mk (source f d 0) n V) := by
        rw [initialGenerator, DirectSum.of_mul_of]
        change DirectSum.of _ (d s + (n - d s))
          (product (source f d 0) (d s) (n - d s) (mk (source f d 0) (d s) ⟨f s,hf s⟩)
            (mk (source f d 0) (n - d s) B)) = _
        rw [product_mk]
        have hσ := sigma_mk_eq (source f d 0) (Nat.add_sub_of_le hd)
          (⟨f s * b, (source f d 0).term_mul (hf s) hb⟩) V
          (by simpa [V, mul_comm] using hvb)
        exact congrArg (fun x : GradedMonoid (Piece (source f d 0)) => DirectSum.of _ x.1 x.2) hσ
      change DirectSum.of _ n (mk (source f d 0) n V) ∈ _
      rw [← hprod]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨s, Nat.lt_succ_self s⟩, rfl⟩)
    · rw [if_neg hd, Submodule.mem_bot] at hv
      have hV : V = 0 := Subtype.ext hv
      change DirectSum.of _ n (mk (source f d 0) n V) ∈ _
      rw [hV, mk, Submodule.Quotient.mk_zero, map_zero]
      exact Ideal.zero_mem _

/-- The actual kernel ideal of the graded projection. -/
theorem projection_ker (s : ℕ) : RingHom.ker (projection f d s) = initialIdeal f d hf s := by
  apply le_antisymm
  · intro x hx
    classical
    rw [← DirectSum.sum_support_of x]
    apply Ideal.sum_mem
    intro n _
    have hn : projectionPiece f d s n (x n) = 0 := by
      rw [← projection_apply, RingHom.mem_ker.mp hx]
      rfl
    generalize he : x n = a at hn ⊢
    induction a using piece_induction (source f d 0) with
    | h a =>
      rw [projectionPiece_mk, mk, Submodule.Quotient.mk_eq_zero] at hn
      exact relI_mem_initialIdeal f d hf s n a hn
  · apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    rw [RingHom.mem_ker, initialGenerator, projection_of, projectionPiece_mk]
    have hi : f i ∈ relI f d s (d i) := by
      apply relI_mono (show i.val+1 ≤ s by omega) (d i)
      change f i ∈ relI f d i (d i) ⊔ (if d i ≤ d i then Ideal.span {f i} * 𝔪 ^ (d i - d i) else ⊥)
      apply Ideal.mem_sup_right
      rw [if_pos le_rfl, Nat.sub_self, pow_zero, mul_one]
      exact Ideal.mem_span_singleton_self _
    have h0 : mk (source f d s) (d i) ⟨f i,hf i⟩ = 0 :=
      Submodule.Quotient.mk_eq_zero.mpr hi
    rw [h0, map_zero]

/-- The source ring really is the quotient of the associated graded ring by
 the homogeneous initial-form ideal. -/
noncomputable def initialQuotientEquiv (s : ℕ) :
    (GrBase f d ⧸ initialIdeal f d hf s) ≃+* GrSource f d s :=
  (Ideal.quotEquivOfEq (projection_ker f d hf s).symm).trans
    (RingHom.quotientKerEquivOfSurjective (projection_surjective f d s))

noncomputable def lemma41_initialQuotientEquiv
    (hreg : ∀ i, InitialRegularRel 𝔪 (firstIdeal f i) (f i) (d i)) (s : ℕ) :
    (GrBase f d ⧸ initialIdeal f d hf s) ≃+*
      (⨁ n, Piece (target (firstIdeal f s)) n) :=
  (initialQuotientEquiv f d hf s).trans (lemma41_ringEquiv f d hf hreg s)

end Brent.CM.GradedRingAssembly
