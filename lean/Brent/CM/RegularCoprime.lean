import Brent.Groebner.Paper

/-!
# The 54 quadrics form a regular sequence (roadmap step D, lines 421–436)

DRAFT, NOT YET COMPILED.

Paper: *By Buchberger's product criterion the `qᵢ` form a Gröbner basis of their homogeneous
ideal. Its initial ideal is generated by the 54 pairwise coprime monomials … In the polynomial
ring localized at the homogeneous maximal ideal, 54 generators of an ideal of height 54 form a
regular sequence by Cohen–Macaulayness. The regularity holds in the graded ring as well …*

**Route.** Mathlib at our pin has no Cohen–Macaulay rings (`RingTheory/Regular/Depth.lean` has
two lemmas), so the unmixedness step is replaced by the direct Gröbner argument, which uses the
same input (the product criterion of row 11 and the pairwise coprime leading monomials) and
proves the same conclusion, in the graded polynomial ring itself:

* `mem_of_mul_mem_of_coprime`: if `g₁, …, g_s` are monic with pairwise coprime leading
  monomials, then `g_i` is a nonzerodivisor modulo `(g_j : j < i)`. Divide `h` by the Gröbner
  basis `(g_j)_{j<i}` with remainder `r`; then `g_i r ∈ (g_j)_{j<i}`, and if `r ≠ 0` some leading
  monomial `LM(g_j)` divides `LM(g_i) LM(r)`, hence (coprimality) divides `LM(r)`, which the
  remainder forbids.
* `q_regular`: **the 54 quadrics are a regular sequence** in `𝔽₃[x, y]`: each `q_i` is a
  nonzerodivisor modulo `(q_j : j < i)`.

The height-54 statements of the paper are `Brent.Groebner.MonomialHeight.height_pairIdeal`.
This file records that the CM step is proved by a different argument (see `AUDIT_TABLE.md`).
-/

namespace Brent.CM

open MvPolynomial MonomialOrder Brent.Groebner Brent.Groebner.Paper

variable {σ R : Type*} [Field R] (m : MonomialOrder σ)

/-- **Coprime leading monomials give a regular sequence.** If the `g j` are monic with pairwise
coprime leading monomials, then for every `i`, `g i * h ∈ (g j : j < i)` implies
`h ∈ (g j : j < i)`. -/
theorem mem_of_mul_mem_of_coprime {s : ℕ} (g : Fin s → MvPolynomial σ R)
    (hmon : ∀ l, m.Monic (g l))
    (hcop : ∀ i j, i ≠ j → ∀ x, m.degree (g i) x = 0 ∨ m.degree (g j) x = 0)
    (i : Fin s) {h : MvPolynomial σ R}
    (hh : g i * h ∈ Ideal.span (Set.range fun j : {j : Fin s // j < i} => g j)) :
    h ∈ Ideal.span (Set.range fun j : {j : Fin s // j < i} => g j) := by
  classical
  set g' : {j : Fin s // j < i} → MvPolynomial σ R := fun j => g j with hg'
  set J := Ideal.span (Set.range g')
  have hmon' : ∀ l, m.Monic (g' l) := fun l => hmon l
  have hcop' : ∀ a b : {j : Fin s // j < i}, a ≠ b →
      ∀ x, m.degree (g' a) x = 0 ∨ m.degree (g' b) x = 0 :=
    fun a b hab => hcop a b (fun h => hab (Subtype.ext h))
  have hGB := (isGroebnerBasis_iff m).mp (isGroebnerBasis_of_coprime m g' hmon' hcop')
  obtain ⟨c, r, hdiv, -, hrem⟩ := m.div (b := g')
    (fun l => by rw [(hmon' l).leadingCoeff_eq_one]; exact isUnit_one) h
  have hsum : Finsupp.linearCombination _ g' c ∈ J := by
    rw [← Finsupp.range_linearCombination]
    exact LinearMap.mem_range_self _ c
  -- `g i * r ∈ J`
  have hr : g i * r ∈ J := by
    have : g i * r = g i * h - g i * Finsupp.linearCombination _ g' c := by
      rw [hdiv]; ring
    rw [this]
    exact J.sub_mem hh (J.mul_mem_left _ hsum)
  by_cases hr0 : r = 0
  · rw [hdiv, hr0, add_zero]
    exact hsum
  · exfalso
    have hgi0 : g i ≠ 0 := (hmon i).ne_zero
    have hprod0 : g i * r ≠ 0 := mul_ne_zero hgi0 hr0
    obtain ⟨_, ⟨j, rfl⟩, -, hle⟩ := hGB.2 _ hr hprod0
    rw [m.degree_mul hgi0 hr0] at hle
    have hjr : m.degree (g' j) ≤ m.degree r := by
      rw [Finsupp.le_def]
      intro x
      have hx := Finsupp.le_def.mp hle x
      rw [Finsupp.add_apply] at hx
      show m.degree (g j) x ≤ m.degree r x
      rcases hcop (j : Fin s) i (ne_of_lt j.2) x with h0 | h0
      · rw [h0]
        exact Nat.zero_le _
      · rw [h0, zero_add] at hx
        exact hx
    exact hrem _ ((m.degree_mem_support_iff r).mpr hr0) j hjr

/-- **The 54 quadrics form a regular sequence** in `𝔽₃[x₀..x₅₃, y₀..y₅₃]`: for each `i`,
`q_i h ∈ (q_j : j < i)` implies `h ∈ (q_j : j < i)`. -/
theorem q_regular (i : Fin 54) {h : MvPolynomial (Fin 54 ⊕ Fin 54) (ZMod 3)}
    (hh : q i * h ∈ Ideal.span (Set.range fun j : {j : Fin 54 // j < i} => q j)) :
    h ∈ Ideal.span (Set.range fun j : {j : Fin 54 // j < i} => q j) :=
  mem_of_mul_mem_of_coprime lexXY q monic_q coprime_degree i hh

end Brent.CM
