import Brent.CM.Lemma41
import Brent.CM.HilbertSamuelPoly
import Brent.CM.PolyType
import Mathlib.Data.Sym.Card
import Mathlib.Data.Nat.Choose.Bounds

/-!
# Discharging the Hilbert-function hypothesis of Lemma 4.1

DRAFT, NOT YET COMPILED.

`Brent.CM.lemma41` assumes `hA : OrderLE (hilbR f d 0) N`: the Hilbert function
`n ↦ length (mⁿ / mⁿ⁺¹)` of `A` has order `≤ N`. This holds as soon as `m` is generated by
`N` elements, which is the case of the paper (`A = k⟦z₁, …, z_N⟧`, `m = (z₁, …, z_N)`):

* `length_le_card`: a module killed by `m` and spanned by `r` elements has length `≤ r`
  (it is a quotient of `(A ⧸ m)ʳ`, and `A ⧸ m` is simple);
* `pow_le_span_mono`: `mⁿ` is spanned by the monomials of degree `n` in the generators,
  indexed by `Sym (Fin N) n`, of cardinality `C(n + N − 1, n)`;
* `orderLE_hilbR_zero_some`: `hilbR f d 0` has polynomial type (Hilbert–Samuel, via
  `orderLE_chi ⊥` and `chi_eq_partialSum`);
* `orderLE_hilbR_zero`: **`hA` for `m` generated by `N = b + 1` elements**, by comparison
  (`orderLE_of_bound`) with `C(n + b, b) ≤ (b + 1)ᵇ (n + 1)ᵇ`;
* `lemma41_of_span`: Lemma 4.1 with `hA` replaced by this generation hypothesis.
-/

namespace Brent.CM

open IsLocalRing

universe u

variable {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

local notation "𝔪" => maximalIdeal A

/-! ### Modules killed by `m` -/

section Killed

variable {M : Type*} [AddCommGroup M] [Module A M]

/-- `A ⧸ m` has length one. -/
theorem length_residue : Module.length A (A ⧸ 𝔪) = 1 :=
  Module.length_eq_one_iff.mpr
    (isSimpleModule_iff_quot_maximal.mpr ⟨𝔪, inferInstance, ⟨LinearEquiv.refl _ _⟩⟩)

/-- **A module killed by `m` and spanned by a finite family has length at most its size.** -/
theorem length_le_card {ι : Type*} [Fintype ι] [DecidableEq ι]
    (hM : ∀ a ∈ 𝔪, ∀ y : M, a • y = 0) (v : ι → M)
    (hv : Submodule.span A (Set.range v) = ⊤) :
    Module.length A M ≤ Fintype.card ι := by
  let φ : ι → (A ⧸ 𝔪) →ₗ[A] M := fun i =>
    (𝔪 : Submodule A A).liftQ (LinearMap.toSpanSingleton A M (v i)) fun a ha => by
      rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
      exact hM a ha (v i)
  let Φ : (ι → A ⧸ 𝔪) →ₗ[A] M := ∑ i, (φ i).comp (LinearMap.proj i)
  have hΦ : Function.Surjective Φ := by
    rw [← LinearMap.range_eq_top, eq_top_iff, ← hv, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    refine ⟨Pi.single i (Submodule.Quotient.mk (1 : A)), ?_⟩
    show (∑ j, (φ j).comp (LinearMap.proj j)) (Pi.single i (Submodule.Quotient.mk (1 : A))) = v i
    rw [LinearMap.sum_apply, Finset.sum_eq_single i]
    · simp [φ, Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply]
    · intro j _ hj
      simp [Pi.single_eq_of_ne hj]
    · intro h
      exact absurd (Finset.mem_univ i) h
  calc Module.length A M ≤ Module.length A (ι → A ⧸ 𝔪) :=
        Module.length_le_of_surjective Φ hΦ
    _ = Fintype.card ι := by
        rw [Module.length_pi_of_fintype A (fun _ : ι => A ⧸ 𝔪)]
        simp only [length_residue, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]

/-- The same bound for `lenZ`. -/
theorem lenZ_le_card {M : Type u} [AddCommGroup M] [Module A M] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (hM : ∀ a ∈ 𝔪, ∀ y : M, a • y = 0) (v : ι → M)
    (hv : Submodule.span A (Set.range v) = ⊤) :
    lenZ (A := A) M ≤ Fintype.card ι := by
  have h := length_le_card hM v hv
  have : (Module.length A M).toNat ≤ Fintype.card ι := by
    have h' := toNat_le_toNat' (ENat.coe_ne_top _) h
    rwa [ENat.toNat_coe] at h'
  unfold lenZ
  exact_mod_cast this

end Killed

/-! ### Monomials in the generators -/

section Monomials

variable {N : ℕ} (g : Fin N → A)

/-- The monomial `∏_{i ∈ σ} gᵢ` attached to a multiset of size `n`. -/
noncomputable def mono {n : ℕ} (σ : Sym (Fin N) n) : A :=
  ((σ : Multiset (Fin N)).map g).prod

theorem mono_cons {n : ℕ} (i : Fin N) (σ : Sym (Fin N) n) :
    mono g (i ::ₛ σ) = g i * mono g σ := by
  simp only [mono, Sym.coe_cons, Multiset.map_cons, Multiset.prod_cons]

variable (hg : Ideal.span (Set.range g) = 𝔪)
include hg

theorem gen_mem (i : Fin N) : g i ∈ 𝔪 := hg ▸ Ideal.subset_span ⟨i, rfl⟩

theorem mono_mem : ∀ {n : ℕ} (σ : Sym (Fin N) n), mono g σ ∈ 𝔪 ^ n
  | 0, _ => by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
  | n + 1, σ => by
    obtain ⟨i, σ', rfl⟩ := Sym.exists_eq_cons_of_succ σ
    rw [mono_cons, pow_succ']
    exact Ideal.mul_mem_mul (gen_mem g hg i) (mono_mem σ')

/-- **`mⁿ` is spanned by the monomials of degree `n`.** -/
theorem pow_le_span_mono : ∀ n : ℕ,
    𝔪 ^ n ≤ Ideal.span (Set.range fun σ : Sym (Fin N) n => mono g σ)
  | 0 => by
    rw [pow_zero, Ideal.one_eq_top, top_le_iff, Ideal.eq_top_iff_one]
    refine Ideal.subset_span ⟨Sym.nil, ?_⟩
    simp [mono, Sym.coe_nil]
  | n + 1 => by
    rw [pow_succ]
    calc 𝔪 ^ n * 𝔪 ≤ Ideal.span (Set.range fun σ : Sym (Fin N) n => mono g σ) *
          Ideal.span (Set.range g) := Ideal.mul_mono (pow_le_span_mono n) hg.ge
      _ = Ideal.span ((Set.range fun σ : Sym (Fin N) n => mono g σ) * Set.range g) :=
          Ideal.span_mul_span' _ _
      _ ≤ _ := by
          rw [Ideal.span_le]
          rintro _ ⟨_, ⟨σ, rfl⟩, _, ⟨i, rfl⟩, rfl⟩
          refine Ideal.subset_span ⟨i ::ₛ σ, ?_⟩
          rw [mono_cons, mul_comm]

end Monomials

/-! ### The Hilbert function of `A` -/

section HilbR

variable (f : ℕ → A) (d : ℕ → ℕ)

theorem relI_zero (n : ℕ) : relI f d 0 n = 𝔪 ^ (n + 1) := rfl

/-- **`length (mⁿ / mⁿ⁺¹) ≤ #Sym (Fin N) n`** when `m` is generated by `N` elements. -/
theorem hilbR_zero_le {N : ℕ} (g : Fin N → A) (hg : Ideal.span (Set.range g) = 𝔪) (n : ℕ) :
    hilbR f d 0 n ≤ Fintype.card (Sym (Fin N) n) := by
  classical
  let v : Sym (Fin N) n → RPiece f d 0 n := fun σ =>
    Submodule.Quotient.mk ⟨mono g σ, mono_mem g hg σ⟩
  refine lenZ_le_card (A := A) ?_ v ?_
  · -- killed by `m`
    intro a ha y
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ y
    rw [Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_comap, Submodule.subtype_apply, Submodule.coe_smul, smul_eq_mul,
      relI_zero, pow_succ']
    exact Ideal.mul_mem_mul ha x.2
  · -- spanned by the monomials
    rw [eq_top_iff]
    rintro y -
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ y
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (pow_le_span_mono g hg n x.2)
    have hx : x = ∑ σ, c σ • (⟨mono g σ, mono_mem g hg σ⟩ : (𝔪 ^ n : Ideal A)) := by
      apply Subtype.ext
      rw [Submodule.coe_sum, ← hc]
      rfl
    rw [hx, map_sum]
    refine Submodule.sum_mem _ fun σ _ => ?_
    rw [map_smul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨σ, rfl⟩)

/-- Two quotients of the same shape have the same length. -/
theorem lenZ_sub_congr {I I' K K' : Ideal A} (h1 : I = I') (h2 : K = K') :
    lenZ (A := A) (I ⧸ K.comap I.subtype) = lenZ (A := A) (I' ⧸ K'.comap I'.subtype) := by
  subst h1
  subst h2
  rfl

/-- `hilbR f d 0` is the Hilbert function of `gr_m A`, i.e. of `grFam ⊥`. -/
theorem hilbR_zero_eq (n : ℕ) : hilbR f d 0 n = lenZ (A := A) (grFam (⊥ : Ideal A) n) :=
  lenZ_sub_congr (bot_sup_eq _).symm (by rw [relI_zero, bot_sup_eq])

/-- **`hilbR f d 0` has polynomial type** (Hilbert–Samuel). -/
theorem orderLE_hilbR_zero_some : ∃ a, OrderLE (hilbR f d 0) a := by
  obtain ⟨a, n₀, h⟩ := orderLE_chi (⊥ : Ideal A)
  refine ⟨a, n₀, fun n hn => ?_⟩
  have hdiff : hilbR f d 0 = diff (chi (⊥ : Ideal A)) := by
    have hchi : chi (⊥ : Ideal A) = partialSum (fun j => lenZ (A := A) (grFam (⊥ : Ideal A) j)) :=
      funext (chi_eq_partialSum ⊥)
    rw [hchi, diff_partialSum]
    exact funext (hilbR_zero_eq f d)
  rw [hdiff, ← diffPow_succ', diffPow_succ]
  simp only [diff]
  rw [h (n + 1) (by omega), h n hn, sub_zero]

/-- `C(n + b, b) ≤ (b + 1)ᵇ (n + 1)ᵇ`. -/
theorem choose_le_bound (b n : ℕ) :
    ((n + b).choose b : ℝ) ≤ ((b + 1 : ℕ) : ℝ) ^ b * ((n : ℝ) + 1) ^ b := by
  have h1 : (n + b).choose b ≤ (n + b) ^ b := Nat.choose_le_pow _ _
  have h2 : (n + b) ^ b ≤ ((b + 1) * (n + 1)) ^ b :=
    Nat.pow_le_pow_left (by nlinarith) b
  have h3 : ((n + b).choose b : ℝ) ≤ (((b + 1) * (n + 1)) ^ b : ℕ) := by
    exact_mod_cast h1.trans h2
  rw [← mul_pow]
  calc ((n + b).choose b : ℝ) ≤ (((b + 1) * (n + 1)) ^ b : ℕ) := h3
    _ = ((b + 1 : ℕ) : ℝ) ^ b * ((n : ℝ) + 1) ^ b := by push_cast; rw [mul_pow]
    _ = (((b + 1 : ℕ) : ℝ) * ((n : ℝ) + 1)) ^ b := by rw [mul_pow]

/-- **The hypothesis `hA` of Lemma 4.1** for a local ring whose maximal ideal is generated by
`b + 1` elements: the Hilbert function of `gr_m A` has order `≤ b + 1`. -/
theorem orderLE_hilbR_zero {b : ℕ} (g : Fin (b + 1) → A) (hg : Ideal.span (Set.range g) = 𝔪) :
    OrderLE (hilbR f d 0) (b + 1) := by
  classical
  obtain ⟨a, ha⟩ := orderLE_hilbR_zero_some f d
  refine orderLE_of_bound (n₁ := 0) (Cb := ((b + 1 : ℕ) : ℝ) ^ b) ha fun n _ => ?_
  have hnn : (0 : ℝ) ≤ (hilbR f d 0 n : ℝ) := by
    have : (0 : ℤ) ≤ hilbR f d 0 n := Int.natCast_nonneg _
    exact_mod_cast this
  rw [abs_of_nonneg hnn]
  have hle := hilbR_zero_le f d g hg n
  rw [Sym.card_sym_eq_choose, Fintype.card_fin, show b + 1 + n - 1 = n + b by omega,
    Nat.choose_symm_add] at hle
  have hle' : (hilbR f d 0 n : ℝ) ≤ ((n + b).choose b : ℝ) := by exact_mod_cast hle
  exact hle'.trans (choose_le_bound b n)

end HilbR

/-! ### Lemma 4.1 for a maximal ideal generated by `N` elements -/

/-- **Lemma 4.1 (paper form).** If `m` is generated by `b + 1` elements and the initial forms of
`f₀, …, f_{s-1}` (of degrees `dᵢ`) form a regular sequence in `gr_m A` (`hreg`), then for any
ideal `I` containing the `fᵢ`, `dim (A ⧸ I) ≤ (b + 1) − s`. -/
theorem lemma41_of_span {b s : ℕ} (g : Fin (b + 1) → A) (hg : Ideal.span (Set.range g) = 𝔪)
    (f : ℕ → A) (d : ℕ → ℕ) (hf : ∀ i, f i ∈ 𝔪 ^ d i)
    (hreg : ∀ (i n : ℕ) (a : A), a ∈ 𝔪 ^ n → f i * a ∈ relI f d i (n + d i) →
      a ∈ relI f d i n)
    {I : Ideal A} (hI : ∀ j < s, f j ∈ I) :
    ringKrullDim (A ⧸ I) ≤ ((b + 1 - s : ℕ) : WithBot ℕ∞) :=
  lemma41 (s := s) f d hf hreg (orderLE_hilbR_zero f d g hg) hI

end Brent.CM
