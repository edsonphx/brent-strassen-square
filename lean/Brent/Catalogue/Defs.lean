import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.Field.ZMod
import Brent.Catalogue.Point

/-!
# The catalogue census: definitions (as stated in `TASKS.md`)

`factor p s m` is read from the packed data generated by `scripts/gen_catalogue_lean.py` from
`alphatensor_14236_factorizations.npz` (SHA-256 checked by the generator):
`factor p s m i j = factorizations[p, s, m, 4 * i + j]`.
-/

namespace Brent.Catalogue

open Classical in
/-- The factor matrices of catalogue point `p` (entries from the generated data). -/
def factor (p : Fin 14236) (s : Fin 49) (m : Fin 3) : Matrix (Fin 4) (Fin 4) ℤ :=
  fun i j => ent (pointNat p.val) s.val m.val i.val j.val

/-- Ranks over a field. -/
noncomputable def rk (K : Type) [Field K] (p : Fin 14236) (s : Fin 49) (m : Fin 3) : ℕ :=
  ((factor p s m).map (Int.cast : ℤ → K)).rank

/-- The rank-triple multiset of point `p`. -/
noncomputable def profile (K : Type) [Field K] (p : Fin 14236) : Multiset (ℕ × ℕ × ℕ) :=
  (Finset.univ : Finset (Fin 49)).val.map fun s => (rk K p s 0, rk K p s 1, rk K p s 2)

def fullProfile : Multiset (ℕ × ℕ × ℕ) :=
  Multiset.replicate 36 (1, 1, 1) + Multiset.replicate 12 (2, 2, 2) + {(4, 4, 4)}

/-- The paper's two rank bounds (lines 670–674): at most 13 summands have some mode rank above
one, and at most one summand has some mode rank above two. -/
def RankBounds (K : Type) [Field K] (p : Fin 14236) : Prop :=
  (Finset.univ.filter fun s : Fin 49 => ∃ m, 1 < rk K p s m).card ≤ 13 ∧
  (Finset.univ.filter fun s : Fin 49 => ∃ m, 2 < rk K p s m).card ≤ 1

/-! ### The anchor test (paper lines 676–694, `alphatensor_rank_profiles.py`) -/

/-- The row space over `K` of an integer matrix (the span of its rows in `K⁴`). -/
noncomputable def rowSpace (K : Type) [Field K] (M : Matrix (Fin 4) (Fin 4) ℤ) :
    Submodule K (Fin 4 → K) :=
  Submodule.span K (Set.range (M.map (Int.cast : ℤ → K)))

/-- The column space over `K` of an integer matrix. -/
noncomputable def colSpace (K : Type) [Field K] (M : Matrix (Fin 4) (Fin 4) ℤ) :
    Submodule K (Fin 4 → K) :=
  rowSpace K M.transpose

/-- `a` can anchor `t`: in every mode, the row space and the column space of `F t m` are
contained in those of `F a m` over `K`. -/
def CanAnchor (K : Type) [Field K] (p : Fin 14236) (t a : Fin 49) : Prop :=
  ∀ m : Fin 3, rowSpace K (factor p t m) ≤ rowSpace K (factor p a m) ∧
    colSpace K (factor p t m) ≤ colSpace K (factor p a m)

open Classical in
/-- The rank-one summands (rank triple `(1, 1, 1)`). -/
noncomputable def rankOne (K : Type) [Field K] (p : Fin 14236) : Finset (Fin 49) :=
  Finset.univ.filter fun s => ∀ m, rk K p s m = 1

open Classical in
/-- The rank-two summands (rank triple `(2, 2, 2)`). -/
noncomputable def rankTwo (K : Type) [Field K] (p : Fin 14236) : Finset (Fin 49) :=
  Finset.univ.filter fun s => ∀ m, rk K p s m = 2

open Classical in
/-- The rank-one children of `a`. -/
noncomputable def children (K : Type) [Field K] (p : Fin 14236) (a : Fin 49) : Finset (Fin 49) :=
  (rankOne K p).filter fun t => CanAnchor K p t a

/-- A rank-two summand with at least six rank-one children (a candidate anchor). -/
def Useful (K : Type) [Field K] (p : Fin 14236) (a : Fin 49) : Prop :=
  a ∈ rankTwo K p ∧ 6 ≤ (children K p a).card

open Classical in
/-- The anchor test: at least six rank-two summands each have at least six rank-one children,
and every rank-one summand has at least one such candidate anchor. -/
def AnchorTest (K : Type) [Field K] (p : Fin 14236) : Prop :=
  6 ≤ ((rankTwo K p).filter (Useful K p)).card ∧
    ∀ t ∈ rankOne K p, ∃ a, Useful K p a ∧ CanAnchor K p t a

end Brent.Catalogue
