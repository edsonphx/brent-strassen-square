import Brent.LocalDimension
import Brent.Differential
import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Embedding-dimension bound for the Brent local ring

At any solution `p` of the Brent equations, the Krull dimension of the local
ring of the ordered Brent scheme at `p` is at most the number of variables
minus the rank of the Jacobian at `p`. The proof is Nakayama plus Krull's
height theorem (`localDimension_le_of_power_le_span_sup_pow` with `d = 1`):
the cubic expansion `Decomposition.entry_line` shows that each linearized
equation lies in the square of the maximal ideal, so a linear complement of
the Jacobian row space spans the maximal ideal modulo its square.
-/

open scoped BigOperators
open MvPolynomial

namespace Brent

section PointIdeal

variable {R σ : Type*} [CommRing R]

/-- Every polynomial is congruent to its value modulo the translated coordinates. -/
theorem sub_C_eval_mem_span (p : σ → R) (g : MvPolynomial σ R) :
    g - C (eval p g) ∈ Ideal.span (Set.range fun x => X x - C (p x)) := by
  induction g using MvPolynomial.induction_on with
  | C a => simp
  | add f g hf hg =>
    rw [map_add, map_add, add_sub_add_comm]
    exact add_mem hf hg
  | mul_X f i hf =>
    have h : f * X i - C (eval p (f * X i)) =
        (f - C (eval p f)) * X i + C (eval p f) * (X i - C (p i)) := by
      simp only [map_mul, eval_X]
      ring
    rw [h]
    exact add_mem (Ideal.mul_mem_right _ _ hf)
      (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))

/-- The ideal of a rational point is generated by the translated coordinates. -/
theorem ker_eval_eq_span (p : σ → R) :
    RingHom.ker (eval p) = Ideal.span (Set.range fun x => X x - C (p x)) := by
  apply le_antisymm
  · intro g hg
    have h := sub_C_eval_mem_span p g
    rwa [RingHom.mem_ker.mp hg, map_zero, sub_zero] at h
  · rw [Ideal.span_le]
    rintro _ ⟨x, rfl⟩
    simp

end PointIdeal

namespace Decomposition

variable {R α ι : Type*} [CommRing R]

private theorem sum_mode {M : Type*} [AddCommMonoid M] (f : Mode → M) :
    ∑ m, f m = f .u + f .v + f .w := by
  rw [show (Finset.univ : Finset Mode) = {.u, .v, .w} from rfl]
  simp [add_assoc]

/-- The first-order term is linear in the perturbation, with the Jacobian columns as
coefficients. -/
theorem jacobianEntry_eq_sum [Fintype α] [DecidableEq α] [Fintype ι] [DecidableEq ι]
    (p d : Decomposition R α ι) (a b c : α × α) :
    p.jacobianEntry d a b c = ∑ x, d.coordinates x * p.jacobianColumn x a b c := by
  rw [Fintype.sum_prod_type, jacobianEntry]
  apply Finset.sum_congr rfl
  intro s _
  rw [Fintype.sum_prod_type, sum_mode]
  simp only [jacobianColumn_eq, coordinates, mul_ite, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, if_true]
  ring

theorem jacobianColumn_map [DecidableEq α] [DecidableEq ι] [Fintype ι] {S : Type*} [CommRing S]
    (f : R →+* S) (p : Decomposition R α ι) (x : Variable α ι) (a b c : α × α) :
    (p.map f).jacobianColumn x a b c = f (p.jacobianColumn x a b c) := by
  obtain ⟨s, m, x⟩ := x
  cases m <;> simp [jacobianColumn_eq, map, apply_ite f]

theorem entry_map [Fintype ι] {S : Type*} [CommRing S] (f : R →+* S)
    (p : Decomposition R α ι) (a b c : α × α) :
    (p.map f).entry a b c = f (p.entry a b c) := by
  simp [entry, map, map_sum, map_mul]

/-- The polynomial perturbation `X - p` from a point to the generic point. -/
noncomputable def translated (p : Decomposition R α ι) :
    Decomposition (MvPolynomial (Variable α ι) R) α ι where
  u s a := X (s, .u, a) - C (p.u s a)
  v s a := X (s, .v, a) - C (p.v s a)
  w s a := X (s, .w, a) - C (p.w s a)

theorem translated_coordinates (p : Decomposition R α ι) (x : Variable α ι) :
    p.translated.coordinates x = X x - C (p.coordinates x) := by
  obtain ⟨s, m, a⟩ := x
  cases m <;> rfl

/-- Taylor expansion of an actual Brent equation at a solution. -/
theorem equation_eq_expansion [DecidableEq α] [Fintype ι] {p : Decomposition R α ι}
    (hp : p.Solves) (a b c : α × α) :
    equation R α ι a b c = (p.map C).jacobianEntry p.translated a b c +
      (p.map C).quadraticEntry p.translated a b c + p.translated.entry a b c := by
  have h := entry_line (p.map C) p.translated 1 a b c
  have hgen : ((p.map C).line p.translated 1).entry a b c =
      ∑ s, X (s, Mode.u, a) * X (s, Mode.v, b) * X (s, Mode.w, c) := by
    simp [entry, line, map, translated]
  rw [hgen, entry_map, hp a b c] at h
  rw [equation, h]
  ring

end Decomposition

section LocalRing

variable {k α ι : Type*} [Field k] [DecidableEq α] [Fintype ι]

/-- The maximal ideal of the coordinate ring at a solution. -/
noncomputable abbrev pointIdeal (p : Decomposition k α ι) (hp : p.Solves) :
    Ideal (CoordinateRing k α ι) :=
  RingHom.ker (pointEvaluation p hp)

instance pointIdeal_isMaximal (p : Decomposition k α ι) (hp : p.Solves) :
    (pointIdeal p hp).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ (pointEvaluation_surjective p hp)

/-- The local ring of the ordered Brent scheme at a solution. -/
noncomputable abbrev PointLocalRing (p : Decomposition k α ι) (hp : p.Solves) :=
  Localization.AtPrime (pointIdeal p hp)

/-- The structure map from the polynomial ring to the local ring. -/
noncomputable def toPointLocalRing (p : Decomposition k α ι) (hp : p.Solves) :
    MvPolynomial (Variable α ι) k →ₐ[k] PointLocalRing p hp :=
  (IsScalarTower.toAlgHom k (CoordinateRing k α ι) (PointLocalRing p hp)).comp
    (Ideal.Quotient.mkₐ k (brentIdeal k α ι))

theorem maximalIdeal_pointLocalRing (p : Decomposition k α ι) (hp : p.Solves) :
    IsLocalRing.maximalIdeal (PointLocalRing p hp) =
      (RingHom.ker (eval p.coordinates)).map (toPointLocalRing p hp) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  have hP : pointIdeal p hp =
      (RingHom.ker (eval p.coordinates)).map (Ideal.Quotient.mk (brentIdeal k α ι)) := by
    rw [← Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective (pointIdeal p hp),
      RingHom.comap_ker]
    rfl
  conv_lhs => arg 2; rw [hP]
  rw [Ideal.map_map]
  rfl

theorem toPointLocalRing_apply (p : Decomposition k α ι) (hp : p.Solves)
    (g : MvPolynomial (Variable α ι) k) :
    toPointLocalRing p hp g =
      algebraMap (CoordinateRing k α ι) (PointLocalRing p hp) (Ideal.Quotient.mk _ g) :=
  rfl

variable [Fintype α] [DecidableEq ι]

set_option maxHeartbeats 1000000 in
/-- **Embedding-dimension bound.** At a solution, the local Krull dimension is at most
the number of variables minus the rank of the Jacobian. -/
theorem pointLocalDimension_le (p : Decomposition k α ι) (hp : p.Solves) :
    ringKrullDim (PointLocalRing p hp) ≤
      ((Fintype.card (Variable α ι) -
        Module.finrank k (Submodule.span k (Set.range fun x : Variable α ι =>
          fun e : EquationIndex α => p.jacobianColumn x e.1 e.2.1 e.2.2)) : ℕ) : WithBot ℕ∞) := by
  classical
  set A := PointLocalRing p hp
  set φ := toPointLocalRing p hp
  set M := RingHom.ker (eval p.coordinates)
  set m := IsLocalRing.maximalIdeal A
  let y : Variable α ι → A := fun x => φ (X x - C (p.coordinates x))
  have hmM : m = M.map φ := maximalIdeal_pointLocalRing p hp
  have hMs : M = Ideal.span (Set.range fun x => X x - C (p.coordinates x)) :=
    ker_eval_eq_span _
  have hmy : m = Ideal.span (Set.range y) := by
    rw [hmM, hMs, Ideal.map_span, ← Set.range_comp]
    rfl
  -- Translated coordinates lie in the ideal of the point.
  have hT : ∀ x, p.translated.coordinates x ∈ M := by
    intro x
    rw [Decomposition.translated_coordinates, hMs]
    exact Ideal.subset_span ⟨x, rfl⟩
  have hTu : ∀ s a, p.translated.u s a ∈ M := fun s a => hT (s, .u, a)
  have hTv : ∀ s a, p.translated.v s a ∈ M := fun s a => hT (s, .v, a)
  have hTw : ∀ s a, p.translated.w s a ∈ M := fun s a => hT (s, .w, a)
  have hsq : ∀ g ∈ M ^ 2, φ g ∈ m ^ 2 := by
    intro g hg
    rw [hmM, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hg
  have hmul : ∀ {f g : MvPolynomial (Variable α ι) k}, f ∈ M → g ∈ M → f * g ∈ M ^ 2 :=
    fun hf hg => by rw [pow_two]; exact Ideal.mul_mem_mul hf hg
  -- The linearized equations vanish modulo the square of the maximal ideal.
  have hlin : ∀ e : EquationIndex α,
      φ ((p.map C).jacobianEntry p.translated e.1 e.2.1 e.2.2) ∈ m ^ 2 := by
    rintro ⟨a, b, c⟩
    have hmem : equation k α ι a b c ∈ brentIdeal k α ι := Ideal.subset_span ⟨(a, b, c), rfl⟩
    have hQ : (p.map C).quadraticEntry p.translated a b c ∈ M ^ 2 := by
      simp only [Decomposition.quadraticEntry]
      refine Ideal.sum_mem _ fun s _ => ?_
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
      · exact Ideal.mul_mem_right _ _ (hmul (hTu s a) (hTv s b))
      · rw [mul_right_comm]; exact Ideal.mul_mem_right _ _ (hmul (hTu s a) (hTw s c))
      · rw [mul_assoc]; exact Ideal.mul_mem_left _ _ (hmul (hTv s b) (hTw s c))
    have hE : p.translated.entry a b c ∈ M ^ 2 := by
      simp only [Decomposition.entry]
      exact Ideal.sum_mem _ fun s _ => Ideal.mul_mem_right _ _ (hmul (hTu s a) (hTv s b))
    have hJ : (p.map C).jacobianEntry p.translated a b c ∈ brentIdeal k α ι ⊔ M ^ 2 := by
      have h : (p.map C).jacobianEntry p.translated a b c = equation k α ι a b c -
          (p.map C).quadraticEntry p.translated a b c - p.translated.entry a b c := by
        rw [Decomposition.equation_eq_expansion hp]; ring
      rw [h]
      exact Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.mem_sup_left hmem) (Ideal.mem_sup_right hQ))
        (Ideal.mem_sup_right hE)
    have hcomap : brentIdeal k α ι ⊔ M ^ 2 ≤ (m ^ 2).comap φ := by
      refine sup_le (Ideal.span_le.mpr ?_) fun g hg => hsq g hg
      rintro _ ⟨⟨a', b', c'⟩, rfl⟩
      have hmem' : equation k α ι a' b' c' ∈ brentIdeal k α ι :=
        Ideal.subset_span ⟨(a', b', c'), rfl⟩
      change φ (equation k α ι a' b' c') ∈ m ^ 2
      rw [toPointLocalRing_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hmem', map_zero]
      exact Ideal.zero_mem _
    exact hcomap hJ
  -- Linear combinations of the translated coordinates.
  let Ψ : (Variable α ι → k) →ₗ[k] A := Fintype.linearCombination k y
  have hΨ : ∀ c, Ψ c ∈ m := by
    intro c
    rw [hmy, Fintype.linearCombination_apply]
    exact Ideal.sum_mem _ fun x _ =>
      Submodule.smul_of_tower_mem _ _ (Ideal.subset_span ⟨x, rfl⟩)
  let r : EquationIndex α → Variable α ι → k := fun e x => p.jacobianColumn x e.1 e.2.1 e.2.2
  have hΨr : ∀ e, Ψ (r e) ∈ m ^ 2 := by
    intro e
    convert hlin e using 1
    rw [Fintype.linearCombination_apply, Decomposition.jacobianEntry_eq_sum, map_sum]
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [Decomposition.translated_coordinates, Decomposition.jacobianColumn_map, map_mul,
      Algebra.smul_def, mul_comm, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
    rfl
  set Rs := Submodule.span k (Set.range r)
  have hrank : Module.finrank k Rs = Module.finrank k (Submodule.span k (Set.range
      fun x : Variable α ι => fun e : EquationIndex α => p.jacobianColumn x e.1 e.2.1 e.2.2)) := by
    let Mat : Matrix (Variable α ι) (EquationIndex α) k :=
      fun x e => p.jacobianColumn x e.1 e.2.1 e.2.2
    exact (Mat.rank_eq_finrank_span_cols).symm.trans Mat.rank_eq_finrank_span_row
  obtain ⟨Cs, hC⟩ := exists_isCompl Rs
  have hdim := Submodule.finrank_add_eq_of_isCompl hC
  rw [Module.finrank_fintype_fun_eq_card] at hdim
  let b := Module.finBasis k Cs
  let f : Fin (Module.finrank k Cs) → A := fun i => Ψ (b i)
  have hle := localDimension_le_of_power_le_span_sup_pow (A := A) f (fun i => hΨ _)
    one_ne_zero ?_
  · refine hle.trans (WithBot.coe_le_coe.mpr (ENat.coe_le_coe.mpr ?_))
    omega
  rw [pow_one, show 1 + 1 = 2 from rfl]
  refine hmy.le.trans ?_
  rw [Ideal.span_le]
  rintro _ ⟨x, rfl⟩
  have hx : (Pi.single x 1 : Variable α ι → k) ∈ Rs ⊔ Cs := by
    rw [hC.sup_eq_top]; trivial
  obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hx
  have hy : y x = Ψ v + Ψ u := by
    rw [← map_add, add_comm, huv, Fintype.linearCombination_apply_single, one_smul]
  rw [SetLike.mem_coe, hy]
  apply Submodule.add_mem_sup
  · have key : ∀ z ∈ Submodule.span k (Set.range b),
        Ψ (z : Variable α ι → k) ∈ Ideal.span (Set.range f) := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨i, rfl⟩ := hz
        exact Ideal.subset_span ⟨i, rfl⟩
      | zero => rw [Submodule.coe_zero, map_zero]; exact Ideal.zero_mem _
      | add z w _ _ hz hw => rw [Submodule.coe_add, map_add]; exact Ideal.add_mem _ hz hw
      | smul c z _ hz =>
        rw [Submodule.coe_smul, map_smul]; exact Submodule.smul_of_tower_mem _ _ hz
    exact key ⟨v, hv⟩ (b.mem_span _)
  · clear huv hy
    induction hu using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨e, rfl⟩ := hz
      exact hΨr e
    | zero => rw [map_zero]; exact Ideal.zero_mem _
    | add z w _ _ hz hw => rw [map_add]; exact Ideal.add_mem _ hz hw
    | smul c z _ hz => rw [map_smul]; exact Submodule.smul_of_tower_mem _ _ hz

end LocalRing
end Brent
