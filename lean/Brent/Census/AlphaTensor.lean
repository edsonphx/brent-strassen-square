import Brent.Census.Witness
import Brent.Generated.AlphaTensorBound0
import Brent.Generated.AlphaTensorBound1
import Brent.Generated.AlphaTensorBound2
import Brent.Generated.AlphaTensorBound3
import Brent.Generated.AlphaTensorBound4
import Brent.Generated.AlphaTensorBound5

/-!
# §7 census: the AlphaTensor exclusions (F18, part 3)

`boundWitnesses` lists 87 pairs `(n, b)`: `n` is a zero-based index into DeepMind's catalogue
`alphatensor_14236_factorizations.npz` (SHA-256 `15d27e30…ed06a3`), and `b` is a rank-bound
certificate recording entries of point `n`. The data are generated by
`tools/alphatensor_census.py` and checked against the catalogue, independently of the
generator, by `tools/verify_alphatensor_witnesses.py`.

Conventions. The catalogue is cyclic (`Σ u ⊗ v ⊗ w = Σ T[4i+k, 4k+j, 4j+i]`). The repository
point of catalogue entry `n` has `u = U`, `v = V`, `w = Wᵀ` (direct convention, the one of
`matrixMultiplicationEntry`), summand `(i, j) : Fin 7 × Fin 7` = catalogue row `7 i + j`, and
vertex `(a, b) : Fin 2 × Fin 2` = matrix index `2 a + b`. The generator checks that each of
these points solves the direct Brent equations.

**What is proved here** (`alphaTensor_bound_excluded`): over every field of characteristic 0
or 3, every point of `k^2352` that agrees with catalogue entry `n` on the recorded coordinates
lies outside the Zariski closure of the saturated union of the two families. The count is
`boundWitnesses_indices`: 87 distinct catalogue indices.

**What is not proved here.**
* That the remaining 14,149 entries satisfy the rank bounds, and that all of them have the exact
  profile `36 (1,1,1) + 12 (2,2,2) + 1 (4,4,4)`. Those are non-exclusion statements; they need
  every larger minor to vanish, and are checked only by the Python census.
* The anchor exclusion of entries 2445 and 5969. Their certificates are in the JSON output. The
  closure statement needs its own argument (see the F18 handoff notes).
-/

namespace Brent.Census

open Brent Brent.Formal Brent.Formal.FamilyClosure Brent.Census.Generated

/-- The 87 rank-bound certificates. -/
def boundWitnesses : List (ℕ × BoundW) :=
  boundBatch0 ++ boundBatch1 ++ boundBatch2 ++ boundBatch3 ++ boundBatch4 ++ boundBatch5

theorem boundWitnesses_check : ∀ x ∈ boundWitnesses, x.2.check = true := by
  intro x hx
  simp only [boundWitnesses, List.mem_append] at hx
  rcases hx with ((((hx | hx) | hx) | hx) | hx) | hx
  · exact List.all_eq_true.mp boundBatch0_check x hx
  · exact List.all_eq_true.mp boundBatch1_check x hx
  · exact List.all_eq_true.mp boundBatch2_check x hx
  · exact List.all_eq_true.mp boundBatch3_check x hx
  · exact List.all_eq_true.mp boundBatch4_check x hx
  · exact List.all_eq_true.mp boundBatch5_check x hx

/-- **The count.** 87 distinct catalogue indices. -/
theorem boundWitnesses_indices :
    (boundWitnesses.map Prod.fst).Nodup ∧ boundWitnesses.length = 87 := by
  decide +kernel

variable {k : Type} [Field k]

/-- **The 87 rank-bound exclusions.** Every point agreeing with a listed catalogue entry on the
recorded coordinates is outside the closure of the saturated families, in characteristic 0
and 3. -/
theorem alphaTensor_bound_excluded (hk : CharP k 3 ∨ CharZero k) {n : ℕ} {b : BoundW}
    (h : (n, b) ∈ boundWitnesses) (v : Affine k) (hv : b.Agrees v) :
    v ∉ closure (saturation (imageA k true) ∪ saturation (imageA k false)) :=
  b.not_mem_closure hk (boundWitnesses_check _ h) v hv

end Brent.Census
