import Mathlib.RingTheory.MvPolynomial.MonomialOrder
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Gröbner bases with pairwise coprime leading monomials (Row 11, general part)

This file imports only Mathlib.

* `initialIdeal m I`: the ideal generated by the leading monomials of the nonzero elements of `I`.
* `IsGroebnerBasis m G I`: `G ⊆ I`, and the leading monomials of the nonzero elements of `G`
  generate `initialIdeal m I`.
* `isGroebnerBasis_iff`: the equivalent divisibility form. Every nonzero `f ∈ I` has its leading
  monomial divisible by the leading monomial of some nonzero `g ∈ G`.

**Buchberger's product criterion, coprime case** (`isGroebnerBasis_of_coprime`). Let `g : ι → R[σ]`
be a finite family of monic polynomials over a field whose leading monomials are pairwise coprime.
Then `range g` is a Gröbner basis of `Ideal.span (range g)`, and the initial ideal is generated
by the leading monomials (`initialIdeal_span_of_coprime`).

The proof is direct and does not use S-polynomials. Write `dᵢ` for the degree of `gᵢ`, and take
`f = Σ hᵢ gᵢ` with every term of every `hᵢ gᵢ` at most `δ`.

* If `f` has a nonzero coefficient at `δ`, some `hᵢ gᵢ` reaches `δ`, so `deg f = δ = deg hᵢ + dᵢ`
  and `dᵢ ∣ lm f`.
* Otherwise, if two indices `i ≠ j` reach `δ`, then `dⱼ ≤ δ = deg hᵢ + dᵢ`, and `dⱼ` is coprime
  to `dᵢ`, so `dⱼ ≤ deg hᵢ`. Moving the top term `c X^a` of `hᵢ`, with `a = c' + dⱼ`, onto `gⱼ`
  through `X^{dⱼ} = gⱼ − tail gⱼ` (`exch`) removes `i` from the indices reaching `δ` and adds none.
* Once no index reaches `δ`, every term is below `δ`, and the well-founded induction continues
  at a smaller bound.
-/

open MvPolynomial MonomialOrder
open scoped MonomialOrder BigOperators

namespace Brent.Groebner

variable {σ R : Type*} [Field R] (m : MonomialOrder σ)

/-! ### Definitions -/

/-- The initial ideal of `I`: generated by the leading monomials of its nonzero elements. -/
noncomputable def initialIdeal (I : Ideal (MvPolynomial σ R)) : Ideal (MvPolynomial σ R) :=
  Ideal.span ((fun f => monomial (m.degree f) (1 : R)) '' {f | f ∈ I ∧ f ≠ 0})

/-- `G` is a Gröbner basis of `I`: `G ⊆ I` and the leading monomials of the nonzero elements of
`G` generate the initial ideal of `I`. -/
def IsGroebnerBasis (G : Set (MvPolynomial σ R)) (I : Ideal (MvPolynomial σ R)) : Prop :=
  G ⊆ (I : Set (MvPolynomial σ R)) ∧
    initialIdeal m I = Ideal.span ((fun g => monomial (m.degree g) (1 : R)) '' {g | g ∈ G ∧ g ≠ 0})

theorem image_monomial_degree (A : Set (MvPolynomial σ R)) :
    (fun g => monomial (m.degree g) (1 : R)) '' A = (fun s => monomial s (1 : R)) '' (m.degree '' A) := by
  rw [Set.image_image]

theorem mem_support_monomial_one {s t : σ →₀ ℕ} (h : t ∈ (monomial s (1 : R)).support) : t = s := by
  classical
  rw [support_monomial, if_neg one_ne_zero, Finset.mem_singleton] at h
  exact h

/-- **The divisibility form of the definition.** -/
theorem isGroebnerBasis_iff {G : Set (MvPolynomial σ R)} {I : Ideal (MvPolynomial σ R)} :
    IsGroebnerBasis m G I ↔ G ⊆ (I : Set (MvPolynomial σ R)) ∧
      ∀ f ∈ I, f ≠ 0 → ∃ g ∈ G, g ≠ 0 ∧ m.degree g ≤ m.degree f := by
  classical
  constructor
  · rintro ⟨hGI, heq⟩
    refine ⟨hGI, fun f hf hf0 => ?_⟩
    have hmem : monomial (m.degree f) (1 : R) ∈ initialIdeal m I :=
      Ideal.subset_span ⟨f, ⟨hf, hf0⟩, rfl⟩
    rw [heq, image_monomial_degree, mem_ideal_span_monomial_image] at hmem
    have hs : m.degree f ∈ (monomial (m.degree f) (1 : R)).support := by
      rw [support_monomial, if_neg one_ne_zero]
      exact Finset.mem_singleton_self _
    obtain ⟨_, ⟨g, ⟨hg, hg0⟩, rfl⟩, hle⟩ := hmem _ hs
    exact ⟨g, hg, hg0, hle⟩
  · rintro ⟨hGI, hdiv⟩
    refine ⟨hGI, le_antisymm ?_ ?_⟩
    · rw [initialIdeal, Ideal.span_le]
      rintro _ ⟨f, ⟨hf, hf0⟩, rfl⟩
      obtain ⟨g, hg, hg0, hle⟩ := hdiv f hf hf0
      rw [SetLike.mem_coe, image_monomial_degree, mem_ideal_span_monomial_image]
      intro xi hxi
      rw [mem_support_monomial_one hxi]
      exact ⟨m.degree g, ⟨g, ⟨hg, hg0⟩, rfl⟩, hle⟩
    · rw [Ideal.span_le]
      rintro _ ⟨g, ⟨hg, hg0⟩, rfl⟩
      exact Ideal.subset_span ⟨g, ⟨hGI hg, hg0⟩, rfl⟩

/-! ### Representations and the exchange step -/

section Coprime

variable {ι : Type*} [Fintype ι] [DecidableEq ι] (g : ι → MvPolynomial σ R)

/-- Every term of every `h l * g l` is at most `δ`, measured on the factors. -/
def Bnd (δ : σ →₀ ℕ) (h : ι → MvPolynomial σ R) : Prop :=
  ∀ l, ∀ μ ∈ (h l).support, m.toSyn (μ + m.degree (g l)) ≤ m.toSyn δ

variable {m g}

theorem bnd_at {p : MvPolynomial σ R} {d X δ : σ →₀ ℕ} (hp : m.toSyn (m.degree p) ≤ m.toSyn X)
    (hX : m.toSyn (X + d) ≤ m.toSyn δ) : ∀ μ ∈ p.support, m.toSyn (μ + d) ≤ m.toSyn δ := by
  intro μ hμ
  rw [map_add] at hX ⊢
  exact le_trans (add_le_add ((m.le_degree hμ).trans hp) le_rfl) hX

theorem ne_zero_of_coeff_mul_ne_zero {p q : MvPolynomial σ R} {d : σ →₀ ℕ}
    (h : (p * q).coeff d ≠ 0) : p ≠ 0 := by
  rintro rfl
  rw [zero_mul, coeff_zero] at h
  exact h rfl

/-- An index whose term reaches `δ` has `deg h + d = δ`. -/
theorem degree_add_eq_of_coeff {δ : σ →₀ ℕ} {h : ι → MvPolynomial σ R} (hB : Bnd m g δ h) {i : ι}
    (hi : (h i * g i).coeff δ ≠ 0) : m.degree (h i) + m.degree (g i) = δ := by
  have hne := ne_zero_of_coeff_mul_ne_zero hi
  have h1 : m.toSyn δ ≤ m.toSyn (m.degree (h i) + m.degree (g i)) :=
    (m.le_degree (mem_support_iff.mpr hi)).trans m.degree_mul_le
  have h2 := hB i _ (m.degree_mem_support hne)
  exact m.toSyn.injective (le_antisymm h2 h1)

/-- The degree of `f` is at most the bound. -/
theorem degree_le_of_bnd {δ : σ →₀ ℕ} {h : ι → MvPolynomial σ R} (hB : Bnd m g δ h)
    {f : MvPolynomial σ R} (hsum : ∑ l, h l * g l = f) : m.toSyn (m.degree f) ≤ m.toSyn δ := by
  rw [degree_le_iff]
  intro c hc
  rw [mem_support_iff, ← hsum, coeff_sum] at hc
  obtain ⟨l, -, hl⟩ := Finset.exists_ne_zero_of_sum_ne_zero hc
  have hne := ne_zero_of_coeff_mul_ne_zero hl
  have h1 : m.toSyn c ≤ m.toSyn (m.degree (h l) + m.degree (g l)) :=
    (m.le_degree (mem_support_iff.mpr hl)).trans m.degree_mul_le
  exact h1.trans (hB l _ (m.degree_mem_support hne))

variable (g) in
/-- The exchanged representation: the top term `monomial a cᵢ` of `h i` is moved onto `g j`. -/
noncomputable def exch (h : ι → MvPolynomial σ R) (i j : ι) (a c : σ →₀ ℕ) (ci : R) :
    ι → MvPolynomial σ R := fun l =>
  h l + (if l = i then -(monomial a ci + monomial c ci * (g j - monomial (m.degree (g j)) 1))
    else 0) + (if l = j then monomial c ci * g i else 0)

variable (m g) in
theorem exch_sum (h : ι → MvPolynomial σ R) {i j : ι} {a c : σ →₀ ℕ} (ci : R)
    (hc : c + m.degree (g j) = a) :
    ∑ l, exch (m := m) g h i j a c ci l * g l = ∑ l, h l * g l := by
  simp only [exch, add_mul, Finset.sum_add_distrib, ite_mul, zero_mul, Finset.sum_ite_eq',
    Finset.mem_univ, if_true]
  have hmono : monomial a ci = monomial c ci * monomial (m.degree (g j)) (1 : R) := by
    rw [monomial_mul, hc, mul_one]
  rw [hmono]
  ring

variable (g) in
theorem exch_left (h : ι → MvPolynomial σ R) {i j : ι} (hij : i ≠ j) (a c : σ →₀ ℕ) (ci : R) :
    exch (m := m) g h i j a c ci i =
      h i + -(monomial a ci + monomial c ci * (g j - monomial (m.degree (g j)) 1)) := by
  simp [exch, hij]

variable (g) in
theorem exch_right (h : ι → MvPolynomial σ R) {i j : ι} (hij : i ≠ j) (a c : σ →₀ ℕ) (ci : R) :
    exch (m := m) g h i j a c ci j = h j + monomial c ci * g i := by
  simp [exch, Ne.symm hij]

variable (g) in
theorem exch_other (h : ι → MvPolynomial σ R) {i j l : ι} (hli : l ≠ i) (hlj : l ≠ j)
    (a c : σ →₀ ℕ) (ci : R) : exch (m := m) g h i j a c ci l = h l := by
  simp [exch, hli, hlj]

theorem degree_tail_le (p : MvPolynomial σ R) :
    m.toSyn (m.degree (p - monomial (m.degree p) 1)) ≤ m.toSyn (m.degree p) :=
  m.degree_sub_le.trans (sup_le le_rfl (degree_monomial_le 1))

/-- **The exchange step.** -/
theorem exchange (hmon : ∀ l, m.Monic (g l))
    (hcop : ∀ i j, i ≠ j → ∀ x, m.degree (g i) x = 0 ∨ m.degree (g j) x = 0)
    {δ : σ →₀ ℕ} {h : ι → MvPolynomial σ R} (hB : Bnd m g δ h) {i j : ι} (hij : i ≠ j)
    (hi : (h i * g i).coeff δ ≠ 0) (hj : (h j * g j).coeff δ ≠ 0) :
    ∃ h' : ι → MvPolynomial σ R, Bnd m g δ h' ∧ ∑ l, h' l * g l = ∑ l, h l * g l ∧
      (h' i * g i).coeff δ = 0 ∧ ∀ l, l ≠ i → l ≠ j → h' l = h l := by
  have ha := degree_add_eq_of_coeff hB hi
  have hb := degree_add_eq_of_coeff hB hj
  obtain ⟨a, haa⟩ : ∃ a, m.degree (h i) = a := ⟨_, rfl⟩
  rw [haa] at ha
  -- coprimality: `dⱼ ≤ a`
  have hdj : m.degree (g j) ≤ a := by
    have hle : m.degree (g j) ≤ a + m.degree (g i) := by
      rw [ha, ← hb]
      exact le_add_self
    rw [Finsupp.le_def] at hle ⊢
    intro x
    have hx := hle x
    rw [Finsupp.add_apply] at hx
    rcases hcop i j hij x with h0 | h0 <;> omega
  obtain ⟨c, hc⟩ : ∃ c, c + m.degree (g j) = a := ⟨a - m.degree (g j), tsub_add_cancel_of_le hdj⟩
  have hai : m.toSyn (m.degree (h i)) ≤ m.toSyn a := le_of_eq (congrArg m.toSyn haa)
  have htail := degree_tail_le (m := m) (g j)
  have hM : ∀ r : R, m.toSyn (m.degree (monomial c r * (g j - monomial (m.degree (g j)) (1 : R)))) ≤
      m.toSyn a := by
    intro r
    refine m.degree_mul_le.trans ?_
    rw [map_add, ← hc, map_add]
    exact add_le_add (degree_monomial_le r) htail
  refine ⟨exch (m := m) g h i j a c ((h i).coeff a), ?_, exch_sum m g h _ hc, ?_,
    fun l hli hlj => exch_other g h hli hlj a c _⟩
  · -- the bound
    intro l
    by_cases hli : l = i
    · rw [hli, exch_left g h hij]
      refine bnd_at (X := a) ?_ (le_of_eq (by rw [ha]))
      refine m.degree_add_le.trans (sup_le hai ?_)
      rw [degree_neg]
      exact m.degree_add_le.trans (sup_le (degree_monomial_le _) (hM _))
    by_cases hlj : l = j
    · rw [hlj, exch_right g h hij]
      have hdeg := m.degree_add_le (f := h j) (g := monomial c ((h i).coeff a) * g i)
      rcases le_total (m.toSyn (m.degree (h j)))
          (m.toSyn (m.degree (monomial c ((h i).coeff a) * g i))) with hle | hle
      · rw [sup_eq_right.mpr hle] at hdeg
        refine bnd_at (X := c + m.degree (g i)) ?_ (le_of_eq (by rw [add_right_comm, hc, ha]))
        refine hdeg.trans (m.degree_mul_le.trans ?_)
        rw [map_add, map_add]
        exact add_le_add (degree_monomial_le _) le_rfl
      · rw [sup_eq_left.mpr hle] at hdeg
        exact bnd_at (X := m.degree (h j)) hdeg (le_of_eq (by rw [hb]))
    · rw [exch_other g h hli hlj]
      exact hB l
  · -- the coefficient at `δ` of the new `i`-th term vanishes
    rw [exch_left g h hij]
    have hgi := (hmon i).coeff_degree
    have hgj := (hmon j).coeff_degree
    have e1 : (h i * g i).coeff (a + m.degree (g i)) = (h i).coeff a := by
      rw [coeff_mul_of_add_of_degree_le (f := h i) (g := g i) (a := a) (b := m.degree (g i))
        hai le_rfl, hgi, mul_one]
    have e2 : (monomial a ((h i).coeff a) * g i).coeff (a + m.degree (g i)) = (h i).coeff a := by
      rw [coeff_mul_of_add_of_degree_le (f := monomial a ((h i).coeff a)) (g := g i) (a := a)
        (b := m.degree (g i)) (degree_monomial_le _) le_rfl, hgi, mul_one, coeff_monomial,
        if_pos rfl]
    have e4 : (monomial c ((h i).coeff a) * (g j - monomial (m.degree (g j)) (1 : R))).coeff
        (c + m.degree (g j)) = 0 := by
      rw [coeff_mul_of_add_of_degree_le (f := monomial c ((h i).coeff a))
        (g := g j - monomial (m.degree (g j)) (1 : R)) (a := c) (b := m.degree (g j))
        (degree_monomial_le _) htail, coeff_sub, hgj, coeff_monomial, if_pos rfl, sub_self,
        mul_zero]
    have e3 : (monomial c ((h i).coeff a) * (g j - monomial (m.degree (g j)) (1 : R)) * g i).coeff
        (a + m.degree (g i)) = 0 := by
      rw [coeff_mul_of_add_of_degree_le
        (f := monomial c ((h i).coeff a) * (g j - monomial (m.degree (g j)) (1 : R))) (g := g i)
        (a := a) (b := m.degree (g i)) (hM _) le_rfl, hgi, mul_one]
      exact (congrArg (fun t => (monomial c ((h i).coeff a) *
        (g j - monomial (m.degree (g j)) (1 : R))).coeff t) hc).symm.trans e4
    have hsplit : (h i + -(monomial a ((h i).coeff a) +
        monomial c ((h i).coeff a) * (g j - monomial (m.degree (g j)) 1))) * g i =
        h i * g i - monomial a ((h i).coeff a) * g i -
          monomial c ((h i).coeff a) * (g j - monomial (m.degree (g j)) 1) * g i := by ring
    rw [hsplit, ← ha, coeff_sub, coeff_sub, e1, e2, e3, sub_self, sub_zero]

variable (g) in
/-- The indices whose term reaches `δ`. -/
noncomputable def topSet (δ : σ →₀ ℕ) (h : ι → MvPolynomial σ R) : Finset ι :=
  Finset.univ.filter fun l => (h l * g l).coeff δ ≠ 0

/-- **Clearing the top degree.** If `f` has zero coefficient at `δ`, there is a representation
in which no term reaches `δ`. -/
theorem clear_top (hmon : ∀ l, m.Monic (g l))
    (hcop : ∀ i j, i ≠ j → ∀ x, m.degree (g i) x = 0 ∨ m.degree (g j) x = 0)
    {δ : σ →₀ ℕ} {f : MvPolynomial σ R} (hf : f.coeff δ = 0) :
    ∀ n : ℕ, ∀ h : ι → MvPolynomial σ R, Bnd m g δ h → ∑ l, h l * g l = f →
      (topSet g δ h).card ≤ n →
      ∃ h' : ι → MvPolynomial σ R, Bnd m g δ h' ∧ ∑ l, h' l * g l = f ∧
        ∀ l, (h' l * g l).coeff δ = 0 := by
  intro n
  induction n with
  | zero =>
    intro h hB hsum hcard
    refine ⟨h, hB, hsum, fun l => ?_⟩
    by_contra hl
    have hmem : l ∈ topSet g δ h := Finset.mem_filter.mpr ⟨Finset.mem_univ l, hl⟩
    have := Finset.card_pos.mpr ⟨l, hmem⟩
    omega
  | succ n ih =>
    intro h hB hsum hcard
    by_cases hall : ∀ l, (h l * g l).coeff δ = 0
    · exact ⟨h, hB, hsum, hall⟩
    push_neg at hall
    obtain ⟨i, hi⟩ := hall
    -- a second index reaching `δ`
    obtain ⟨j, hji, hj⟩ : ∃ j, j ≠ i ∧ (h j * g j).coeff δ ≠ 0 := by
      by_contra hno
      push_neg at hno
      have hs : ∑ l, (h l * g l).coeff δ = (h i * g i).coeff δ :=
        Finset.sum_eq_single_of_mem i (Finset.mem_univ i) fun l _ hl => hno l hl
      rw [← coeff_sum, hsum, hf] at hs
      exact hi hs.symm
    obtain ⟨h', hB', hsum', hi', hother⟩ := exchange hmon hcop hB (Ne.symm hji) hi hj
    refine ih h' hB' (hsum'.trans hsum) ?_
    have hsub : topSet g δ h' ⊆ (topSet g δ h).erase i := by
      intro l hl
      simp only [topSet, Finset.mem_filter, Finset.mem_univ, true_and] at hl
      have hli : l ≠ i := fun hli => hl (by rw [hli]; exact hi')
      rw [Finset.mem_erase]
      refine ⟨hli, ?_⟩
      simp only [topSet, Finset.mem_filter, Finset.mem_univ, true_and]
      by_cases hlj : l = j
      · rw [hlj]
        exact hj
      · rwa [hother l hli hlj] at hl
    have hiT : i ∈ topSet g δ h := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
    have h1 := Finset.card_le_card hsub
    rw [Finset.card_erase_of_mem hiT] at h1
    omega

variable (g) in
/-- A bound valid for a given representation. -/
noncomputable def supBound (h : ι → MvPolynomial σ R) : m.syn :=
  Finset.univ.sup fun l => (h l).support.sup fun μ => m.toSyn (μ + m.degree (g l))

variable (g) in
theorem bnd_supBound (h : ι → MvPolynomial σ R) :
    Bnd m g (m.toSyn.symm (supBound (m := m) g h)) h := by
  intro l μ hμ
  rw [AddEquiv.apply_symm_apply]
  exact (Finset.le_sup (f := fun μ => m.toSyn (μ + m.degree (g l))) hμ).trans
    (Finset.le_sup (f := fun l => (h l).support.sup fun μ => m.toSyn (μ + m.degree (g l)))
      (Finset.mem_univ l))

/-- **The leading monomial of every nonzero element is divisible by some `lm gᵢ`.** -/
theorem exists_degree_le (hmon : ∀ l, m.Monic (g l))
    (hcop : ∀ i j, i ≠ j → ∀ x, m.degree (g i) x = 0 ∨ m.degree (g j) x = 0)
    {f : MvPolynomial σ R} (hf : f ∈ Ideal.span (Set.range g)) (hf0 : f ≠ 0) :
    ∃ i, m.degree (g i) ≤ m.degree f := by
  obtain ⟨h₀, hsum₀⟩ := Ideal.mem_span_range_iff_exists_fun.mp hf
  suffices H : ∀ D : m.syn, ∀ δ : σ →₀ ℕ, m.toSyn δ = D → ∀ h : ι → MvPolynomial σ R,
      Bnd m g δ h → ∑ l, h l * g l = f → ∃ i, m.degree (g i) ≤ m.degree f by
    exact H _ _ (AddEquiv.apply_symm_apply _ _) h₀ (bnd_supBound g h₀) hsum₀
  intro D
  induction D using WellFoundedLT.induction with
  | ind D IH =>
    intro δ hδ h hB hsum
    by_cases hcf : f.coeff δ = 0
    · obtain ⟨h', hB', hsum', htop⟩ := clear_top hmon hcop hcf _ h hB hsum le_rfl
      -- every term of `h'` is now strictly below `δ`
      have hstrict : ∀ l, ∀ μ ∈ (h' l).support, m.toSyn (μ + m.degree (g l)) < m.toSyn δ := by
        intro l μ hμ
        refine lt_of_le_of_ne (hB' l μ hμ) fun heq => ?_
        have hne : h' l ≠ 0 := by
          rintro h0
          rw [h0] at hμ
          simp at hμ
        have h1 := hB' l _ (m.degree_mem_support hne)
        have h2 : m.toSyn (μ + m.degree (g l)) ≤ m.toSyn (m.degree (h' l) + m.degree (g l)) := by
          rw [map_add, map_add]
          exact add_le_add (m.le_degree hμ) le_rfl
        have h3 : m.degree (h' l) + m.degree (g l) = δ :=
          m.toSyn.injective (le_antisymm h1 ((le_of_eq heq.symm).trans h2))
        have hc0 : (h' l * g l).coeff δ ≠ 0 := by
          rw [← h3, coeff_mul_of_add_of_degree_le (f := h' l) (g := g l) (a := m.degree (h' l))
            (b := m.degree (g l)) le_rfl le_rfl, (hmon l).coeff_degree, mul_one]
          exact m.leadingCoeff_ne_zero_iff.mpr hne
        exact hc0 (htop l)
      obtain ⟨l₀, hl₀⟩ : ∃ l, h' l ≠ 0 := by
        by_contra hall
        push_neg at hall
        apply hf0
        rw [← hsum']
        simp [hall]
      have hbot : ⊥ < m.toSyn δ :=
        lt_of_le_of_lt bot_le (hstrict l₀ _ (m.degree_mem_support hl₀))
      have hlt : supBound (m := m) g h' < D := by
        rw [← hδ, supBound, Finset.sup_lt_iff hbot]
        intro l _
        rw [Finset.sup_lt_iff hbot]
        exact hstrict l
      exact IH _ hlt _ (AddEquiv.apply_symm_apply _ _) h' (bnd_supBound g h') hsum'
    · have hs : ∑ l, (h l * g l).coeff δ ≠ 0 := by
        rw [← coeff_sum, hsum]
        exact hcf
      obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hs
      have hdi := degree_add_eq_of_coeff hB hi
      have hdeg : m.degree f = δ :=
        m.toSyn.injective (le_antisymm (degree_le_of_bnd hB hsum) (m.le_degree (mem_support_iff.mpr hcf)))
      exact ⟨i, by rw [hdeg, ← hdi]; exact le_add_self⟩

variable (m g)

/-- **Buchberger's product criterion (coprime case).** Monic polynomials with pairwise coprime
leading monomials form a Gröbner basis of the ideal they generate. -/
theorem isGroebnerBasis_of_coprime (hmon : ∀ l, m.Monic (g l))
    (hcop : ∀ i j, i ≠ j → ∀ x, m.degree (g i) x = 0 ∨ m.degree (g j) x = 0) :
    IsGroebnerBasis m (Set.range g) (Ideal.span (Set.range g)) := by
  rw [isGroebnerBasis_iff]
  refine ⟨Ideal.subset_span, fun f hf hf0 => ?_⟩
  obtain ⟨i, hi⟩ := exists_degree_le hmon hcop hf hf0
  exact ⟨g i, ⟨i, rfl⟩, (hmon i).ne_zero, hi⟩

/-- **The initial ideal is generated by the leading monomials.** -/
theorem initialIdeal_span_of_coprime (hmon : ∀ l, m.Monic (g l))
    (hcop : ∀ i j, i ≠ j → ∀ x, m.degree (g i) x = 0 ∨ m.degree (g j) x = 0) :
    initialIdeal m (Ideal.span (Set.range g)) =
      Ideal.span (Set.range fun l => monomial (m.degree (g l)) (1 : R)) := by
  rw [(isGroebnerBasis_of_coprime m g hmon hcop).2]
  congr 1
  ext p
  constructor
  · rintro ⟨_, ⟨⟨l, rfl⟩, -⟩, rfl⟩
    exact ⟨l, rfl⟩
  · rintro ⟨l, rfl⟩
    exact ⟨g l, ⟨⟨l, rfl⟩, (hmon l).ne_zero⟩, rfl⟩

end Coprime

end Brent.Groebner
