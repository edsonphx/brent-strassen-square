import Mathlib.RingTheory.Ideal.KrullsHeightTheorem
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Polynomial.Basic

/-!
# Height of the matching monomial ideal (§4, lines 444–447)

The initial ideal of the 54 quadrics is generated by the pairwise coprime monomials
`xᵢ y_π(i)` (`Groebner.Paper.q_initialIdeal`). The paper uses that this monomial ideal has
height 54. Here, over any field `K`, for any `n` and any injective `π : Fin n → Fin n`, in
`MvPolynomial (Fin n ⊕ Fin n) K`:

* `prime_contains_pair`: every prime containing `I = (xᵢ y_π(i))` contains `xᵢ` or `y_π(i)`
  for every `i`, that is, one variable from each pair;
* `primeHeight_choice`: the prime generated by one variable from each pair has height `n`;
* `height_pairIdeal`: `I` has height `n`.

The general facts are about the ideal `varIdeal s` generated by a set `s` of variables: it is
prime (the kernel of the map killing those variables), and generated by `n` distinct variables
it has height exactly `n` (a chain of length `n` from below, Krull's height theorem from above).

Imports Mathlib only.
-/

namespace Brent.Groebner.MonomialHeight

open MvPolynomial

variable {K : Type*} [Field K] {σ : Type*}

/-- The ideal generated by the variables in `s`. -/
noncomputable def varIdeal (K : Type*) [Field K] (s : Set σ) : Ideal (MvPolynomial σ K) :=
  Ideal.span (X '' s)

open Classical in
/-- The `K`-algebra map setting the variables in `s` to zero. -/
noncomputable def killVars (s : Set σ) : MvPolynomial σ K →ₐ[K] MvPolynomial σ K :=
  aeval fun v => if v ∈ s then 0 else X v

theorem killVars_X_of_mem {s : Set σ} {v : σ} (hv : v ∈ s) :
    killVars (K := K) s (X v) = 0 := by
  simp [killVars, hv]

theorem killVars_X_of_not_mem {s : Set σ} {v : σ} (hv : v ∉ s) :
    killVars (K := K) s (X v) = X v := by
  simp [killVars, hv]

theorem sub_killVars_mem (s : Set σ) (f : MvPolynomial σ K) :
    f - killVars s f ∈ varIdeal K s := by
  induction f using MvPolynomial.induction_on with
  | C a =>
    simp only [killVars, aeval_C, MvPolynomial.algebraMap_eq, sub_self]
    exact Ideal.zero_mem _
  | add p q hp hq =>
    have h := Ideal.add_mem _ hp hq
    rw [map_add]
    convert h using 1
    ring
  | mul_X p v hp =>
    have hX : X v - killVars s (X v) ∈ varIdeal K s := by
      by_cases hv : v ∈ s
      · rw [killVars_X_of_mem hv, sub_zero]
        exact Ideal.subset_span ⟨v, hv, rfl⟩
      · rw [killVars_X_of_not_mem hv, sub_self]
        exact Ideal.zero_mem _
    have h := Ideal.add_mem _ (Ideal.mul_mem_right (X v) _ hp)
      (Ideal.mul_mem_left _ (killVars s p) hX)
    rw [map_mul]
    convert h using 1
    ring

theorem ker_killVars (s : Set σ) : RingHom.ker (killVars (K := K) s) = varIdeal K s := by
  apply le_antisymm
  · intro f hf
    have h := sub_killVars_mem s f
    rwa [RingHom.mem_ker.mp hf, sub_zero] at h
  · rw [varIdeal, Ideal.span_le]
    rintro _ ⟨v, hv, rfl⟩
    exact RingHom.mem_ker.mpr (killVars_X_of_mem hv)

/-- **An ideal generated by variables is prime.** -/
instance varIdeal_isPrime (s : Set σ) : (varIdeal K s).IsPrime := by
  rw [← ker_killVars]
  exact RingHom.ker_isPrime _

theorem X_not_mem_varIdeal {s : Set σ} {v : σ} (hv : v ∉ s) :
    (X v : MvPolynomial σ K) ∉ varIdeal K s := by
  classical
  rw [varIdeal, mem_ideal_span_X_image]
  intro h
  obtain ⟨i, hi, hne⟩ := h (Finsupp.single v 1) (by simp [support_X])
  rw [Finsupp.single_apply] at hne
  split_ifs at hne with hvi
  · exact hv (by rw [hvi]; exact hi)
  · exact hne rfl

theorem varIdeal_mono {s t : Set σ} (h : s ⊆ t) : varIdeal K s ≤ varIdeal K t :=
  Ideal.span_mono (Set.image_mono h)

/-- The first `k` of the variables `c 0, c 1, …`. -/
abbrev firstVars {n : ℕ} (c : Fin n → σ) (k : ℕ) : Set σ := c '' {i | (i : ℕ) < k}

theorem firstVars_n {n : ℕ} (c : Fin n → σ) : firstVars c n = Set.range c := by
  ext v
  simp

/-- Lower bound: the chain `0 < (c₀) < (c₀, c₁) < ⋯` of primes. -/
theorem le_primeHeight_firstVars {n : ℕ} (c : Fin n → σ) (hc : Function.Injective c) :
    ∀ k ≤ n, (k : ℕ∞) ≤ (varIdeal K (firstVars c k)).primeHeight := by
  intro k hk
  induction k with
  | zero => simp
  | succ k ih =>
    have hlt : varIdeal K (firstVars c k) < varIdeal K (firstVars c (k + 1)) := by
      refine lt_of_le_of_ne (varIdeal_mono (Set.image_mono ?_)) ?_
      · intro i hi
        show (i : ℕ) < k + 1
        have : (i : ℕ) < k := hi
        omega
      · intro heq
        have hmem : (X (c ⟨k, by omega⟩) : MvPolynomial σ K) ∈ varIdeal K (firstVars c (k + 1)) :=
          Ideal.subset_span ⟨c ⟨k, by omega⟩, ⟨⟨k, by omega⟩, Nat.lt_succ_self k, rfl⟩, rfl⟩
        rw [← heq] at hmem
        refine X_not_mem_varIdeal ?_ hmem
        rintro ⟨i, hi, hci⟩
        have h1 : (i : ℕ) < k := hi
        have h2 : (i : ℕ) = k := congrArg Fin.val (hc hci)
        omega
    calc ((k + 1 : ℕ) : ℕ∞) = (k : ℕ∞) + 1 := by push_cast; rfl
      _ ≤ (varIdeal K (firstVars c k)).primeHeight + 1 := by gcongr; exact ih (by omega)
      _ ≤ _ := Ideal.primeHeight_add_one_le_of_lt hlt

/-- **The prime generated by `n` distinct variables has height `n`.** -/
theorem primeHeight_varIdeal_range [Finite σ] {n : ℕ} (c : Fin n → σ)
    (hc : Function.Injective c) :
    (varIdeal K (Set.range c)).primeHeight = n := by
  classical
  apply le_antisymm
  · have hspan : Ideal.span ((Finset.univ.image fun i => (X (c i) : MvPolynomial σ K)) :
        Set (MvPolynomial σ K)) = varIdeal K (Set.range c) := by
      rw [varIdeal]
      congr 1
      ext x
      simp
    have hmin : varIdeal K (Set.range c) ∈ (Ideal.span ((Finset.univ.image
        fun i => (X (c i) : MvPolynomial σ K)) : Set (MvPolynomial σ K))).minimalPrimes := by
      rw [hspan, Ideal.minimalPrimes_eq_subsingleton_self]
      exact Set.mem_singleton _
    have h := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin
    rw [Ideal.height_eq_primeHeight] at h
    refine h.trans ?_
    exact_mod_cast Finset.card_image_le.trans (by simp)
  · have h := le_primeHeight_firstVars (K := K) c hc n le_rfl
    rwa [firstVars_n] at h

/-! ### The matching ideal `(xᵢ y_π(i))` -/

variable {n : ℕ} (π : Fin n → Fin n)

/-- `I = (xᵢ y_π(i) : i < n)`, with `xᵢ = X (inl i)` and `yⱼ = X (inr j)`. -/
noncomputable def pairIdeal (K : Type*) [Field K] : Ideal (MvPolynomial (Fin n ⊕ Fin n) K) :=
  Ideal.span (Set.range fun i => X (Sum.inl i) * X (Sum.inr (π i)))

/-- One variable from each pair: `xᵢ` when `b i`, else `y_π(i)`. -/
def choice (b : Fin n → Bool) (i : Fin n) : Fin n ⊕ Fin n :=
  if b i then Sum.inl i else Sum.inr (π i)

theorem choice_injective (hπ : Function.Injective π) (b : Fin n → Bool) :
    Function.Injective (choice π b) := by
  intro i j h
  by_cases hi : b i <;> by_cases hj : b j <;> simp [choice, hi, hj] at h
  · exact h
  · exact hπ h

/-- **Every prime containing `I` contains one variable from each pair.** -/
theorem prime_contains_pair (p : Ideal (MvPolynomial (Fin n ⊕ Fin n) K)) [hp : p.IsPrime]
    (hI : pairIdeal π K ≤ p) (i : Fin n) :
    X (Sum.inl i) ∈ p ∨ X (Sum.inr (π i)) ∈ p :=
  hp.mem_or_mem (hI (Ideal.subset_span ⟨i, rfl⟩))

theorem exists_choice_le (p : Ideal (MvPolynomial (Fin n ⊕ Fin n) K)) [p.IsPrime]
    (hI : pairIdeal π K ≤ p) :
    ∃ b, varIdeal K (Set.range (choice π b)) ≤ p := by
  classical
  refine ⟨fun i => decide (X (Sum.inl i) ∈ p), ?_⟩
  rw [varIdeal, Ideal.span_le]
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  by_cases h : X (Sum.inl i) ∈ p
  · simpa [choice, h] using h
  · have h' := (prime_contains_pair π p hI i).resolve_left h
    simpa [choice, h] using h'

theorem pairIdeal_le_choice (b : Fin n → Bool) :
    pairIdeal π K ≤ varIdeal K (Set.range (choice π b)) := by
  rw [pairIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  by_cases hb : b i
  · have h : (X (Sum.inl i) : MvPolynomial (Fin n ⊕ Fin n) K) ∈
        varIdeal K (Set.range (choice π b)) :=
      Ideal.subset_span ⟨Sum.inl i, ⟨i, by simp [choice, hb]⟩, rfl⟩
    exact Ideal.mul_mem_right _ _ h
  · have h : (X (Sum.inr (π i)) : MvPolynomial (Fin n ⊕ Fin n) K) ∈
        varIdeal K (Set.range (choice π b)) :=
      Ideal.subset_span ⟨Sum.inr (π i), ⟨i, by simp [choice, hb]⟩, rfl⟩
    exact Ideal.mul_mem_left _ _ h

/-- **The prime generated by one variable from each pair has height `n`.** -/
theorem primeHeight_choice (hπ : Function.Injective π) (b : Fin n → Bool) :
    (varIdeal K (Set.range (choice π b))).primeHeight = n :=
  primeHeight_varIdeal_range _ (choice_injective π hπ b)

/-- **The matching monomial ideal `(xᵢ y_π(i))` has height `n`** (54 in the paper). -/
theorem height_pairIdeal (hπ : Function.Injective π) : (pairIdeal π K).height = n := by
  apply le_antisymm
  · calc (pairIdeal π K).height ≤ (varIdeal K (Set.range (choice π fun _ => true))).height :=
          Ideal.height_mono (pairIdeal_le_choice π _)
      _ = n := by rw [Ideal.height_eq_primeHeight, primeHeight_choice π hπ]
  · unfold Ideal.height
    refine le_iInf₂ fun J hJ => ?_
    haveI := Ideal.minimalPrimes_isPrime hJ
    obtain ⟨b, hb⟩ := exists_choice_le π J hJ.1.2
    rw [← primeHeight_choice (K := K) π hπ b]
    exact Ideal.primeHeight_mono hb

end Brent.Groebner.MonomialHeight
