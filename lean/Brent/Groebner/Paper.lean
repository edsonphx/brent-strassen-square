import Brent.Groebner.Basic
import Brent.KernelCheck.QuadraticCertificates
import Brent.Matching

/-!
# §4, Buchberger step (Row 11): the 54 quadrics form a Gröbner basis

Paper, lines 405–413 and 444–447. With the lexicographic order
`x₀ > ⋯ > x₅₃ > y₀ > ⋯ > y₅₃` over `𝔽₃`, the 54 quadrics `q_ℓ` have monic leading terms
`x_ℓ y_{π(ℓ)}`, which are pairwise coprime. By Buchberger's product criterion the `q_ℓ` form a
Gröbner basis of their ideal, whose initial ideal is generated by the 54 monomials.

* `lexXY`: the lexicographic monomial order on `Fin 54 ⊕ Fin 54`. It is Mathlib's
  `MonomialOrder.lex` for the order `Sum.Lex` (`inl _ < inr _`). The smallest variable is the
  most significant, so `x₀ > ⋯ > x₅₃ > y₀ > ⋯ > y₅₃` (`lt_iff_vIdx`).
* `q ℓ = Σ_{i,j} projectedMixed ℓ i j · x_i y_j`.
* `degree_q`, `monic_q`, `leadingTerm_q`: the leading monomial is `x_ℓ y_{π ℓ}` with coefficient 1.
  The proof uses `archived_mixed_pivots` and `archived_mixed_zero_before`: every coefficient at a
  lex-larger monomial is zero.
* `coprime_degree`: the leading monomials are pairwise coprime (`π` is injective).
* `q_isGroebnerBasis`, `q_initialIdeal`, and the bundle `row11`.
-/

open MvPolynomial MonomialOrder
open scoped MonomialOrder BigOperators

namespace Brent.Groebner.Paper

open Brent Brent.QuadraticData

/-- The variables, ordered `inl 0 < ⋯ < inl 53 < inr 0 < ⋯ < inr 53`. -/
abbrev σL := Fin 54 ⊕ₗ Fin 54

/-- **The lexicographic order** `x₀ > ⋯ > x₅₃ > y₀ > ⋯ > y₅₃` on `Fin 54 ⊕ Fin 54`
(`x_i = X (inl i)`, `y_j = X (inr j)`). -/
noncomputable def lexXY : MonomialOrder (Fin 54 ⊕ Fin 54) := MonomialOrder.lex (σ := σL)

/-- The position of a variable in the order `x₀, …, x₅₃, y₀, …, y₅₃`. -/
def vIdx : Fin 54 ⊕ Fin 54 → ℕ
  | .inl i => i.val
  | .inr j => 54 + j.val

theorem lt_iff_vIdx : ∀ a b : Fin 54 ⊕ Fin 54, toLex a < toLex b ↔ vIdx a < vIdx b
  | .inl a, .inl b => by
    rw [Sum.Lex.inl_lt_inl_iff, Fin.lt_iff_val_lt_val]
    rfl
  | .inl a, .inr b => by
    have := a.isLt
    exact ⟨fun _ => by simp only [vIdx]; omega, fun _ => Sum.Lex.inl_lt_inr a b⟩
  | .inr a, .inl b => by
    have := b.isLt
    exact ⟨fun h => absurd h Sum.Lex.not_inr_lt_inl, fun h => by simp only [vIdx] at h; omega⟩
  | .inr a, .inr b => by
    rw [Sum.Lex.inr_lt_inr_iff, Fin.lt_iff_val_lt_val]
    simp only [vIdx]
    exact ⟨fun h => by omega, fun h => by omega⟩

/-- The exponent of `x_i y_j`. -/
noncomputable def e (i j : Fin 54) : (Fin 54 ⊕ Fin 54) →₀ ℕ :=
  Finsupp.single (Sum.inl i) 1 + Finsupp.single (Sum.inr j) 1

theorem e_inl (i j k : Fin 54) : e i j (Sum.inl k) = if i = k then 1 else 0 := by
  simp [e, Finsupp.single_apply]

theorem e_inr (i j k : Fin 54) : e i j (Sum.inr k) = if j = k then 1 else 0 := by
  simp [e, Finsupp.single_apply]

theorem e_inj {i j i' j' : Fin 54} (h : e i j = e i' j') : i = i' ∧ j = j' := by
  have h1 := DFunLike.congr_fun h (Sum.inl i)
  have h2 := DFunLike.congr_fun h (Sum.inr j)
  rw [e_inl, e_inl, if_pos rfl] at h1
  rw [e_inr, e_inr, if_pos rfl] at h2
  constructor
  · by_contra hne
    rw [if_neg (Ne.symm hne)] at h1
    exact one_ne_zero h1
  · by_contra hne
    rw [if_neg (Ne.symm hne)] at h2
    exact one_ne_zero h2

/-- `x_i y_j > x_{i'} y_{j'}` when `54 i + j < 54 i' + j'`. -/
theorem e_lt_of (i j i' j' : Fin 54) (h : 54 * i'.val + j'.val < 54 * i.val + j.val) :
    e i j ≺[lexXY] e i' j' := by
  have hi := i.isLt
  have hj := j.isLt
  have hi' := i'.isLt
  have hj' := j'.isLt
  show toLex (e i j : σL →₀ ℕ) < toLex (e i' j' : σL →₀ ℕ)
  rw [Finsupp.Lex.lt_iff]
  by_cases hii : i'.val < i.val
  · refine ⟨toLex (Sum.inl i'), fun k' hk' => ?_, ?_⟩
    · obtain ⟨k, rfl⟩ := toLex.surjective k'
      have hk := (lt_iff_vIdx k (Sum.inl i')).mp hk'
      change e i j k = e i' j' k
      rcases k with k | k
      · simp only [vIdx] at hk
        rw [e_inl, e_inl, if_neg (fun h => absurd (congrArg Fin.val h) (by omega)),
          if_neg (fun h => absurd (congrArg Fin.val h) (by omega))]
      · simp only [vIdx] at hk
        omega
    · change e i j (Sum.inl i') < e i' j' (Sum.inl i')
      rw [e_inl, e_inl, if_neg (fun h => absurd (congrArg Fin.val h) (by omega)), if_pos rfl]
      exact Nat.zero_lt_one
  · have hieq : i' = i := Fin.ext (by omega)
    have hjj : j'.val < j.val := by omega
    subst hieq
    refine ⟨toLex (Sum.inr j'), fun k' hk' => ?_, ?_⟩
    · obtain ⟨k, rfl⟩ := toLex.surjective k'
      have hk := (lt_iff_vIdx k (Sum.inr j')).mp hk'
      change e i' j k = e i' j' k
      rcases k with k | k
      · rw [e_inl, e_inl]
      · simp only [vIdx] at hk
        rw [e_inr, e_inr, if_neg (fun h => absurd (congrArg Fin.val h) (by omega)),
          if_neg (fun h => absurd (congrArg Fin.val h) (by omega))]
    · change e i' j (Sum.inr j') < e i' j' (Sum.inr j')
      rw [e_inr, e_inr, if_neg (fun h => absurd (congrArg Fin.val h) (by omega)), if_pos rfl]
      exact Nat.zero_lt_one

theorem e_le_of (i j i' j' : Fin 54) (h : 54 * i'.val + j'.val ≤ 54 * i.val + j.val) :
    e i j ≼[lexXY] e i' j' := by
  rcases h.lt_or_eq with h | h
  · exact le_of_lt (e_lt_of i j i' j' h)
  · have hj := j.isLt
    have hj' := j'.isLt
    have hi : i' = i := Fin.ext (by omega)
    have hj2 : j' = j := Fin.ext (by omega)
    subst hi hj2
    exact le_rfl

/-! ### The quadrics -/

/-- **The quadric** `q_ℓ = Σ_{i,j} c_{ℓ i j} x_i y_j` over `𝔽₃`, with `c_{ℓ i j} = projectedMixed ℓ i j`. -/
noncomputable def q (ell : Fin 54) : MvPolynomial (Fin 54 ⊕ Fin 54) (ZMod 3) :=
  ∑ i, ∑ j, C (projectedMixed ell i j) * X (Sum.inl i) * X (Sum.inr j)

theorem monomial_e (i j : Fin 54) (c : ZMod 3) :
    monomial (e i j) c = C c * X (Sum.inl i) * X (Sum.inr j) := by
  rw [e, mul_assoc, X, X, monomial_mul, C_mul_monomial, mul_one, mul_one]

theorem q_eq (ell : Fin 54) : q ell = ∑ i, ∑ j, monomial (e i j) (projectedMixed ell i j) :=
  Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => (monomial_e i j _).symm

theorem coeff_q (ell i₀ j₀ : Fin 54) : (q ell).coeff (e i₀ j₀) = projectedMixed ell i₀ j₀ := by
  classical
  rw [q_eq, coeff_sum, Finset.sum_eq_single_of_mem i₀ (Finset.mem_univ _)]
  · rw [coeff_sum, Finset.sum_eq_single_of_mem j₀ (Finset.mem_univ _)]
    · rw [coeff_monomial, if_pos rfl]
    · intro j _ hj
      rw [coeff_monomial, if_neg (fun h => hj (e_inj h).2)]
  · intro i _ hi
    rw [coeff_sum]
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [coeff_monomial, if_neg (fun h => hi (e_inj h).1)]

theorem mem_support_q {ell : Fin 54} {μ : (Fin 54 ⊕ Fin 54) →₀ ℕ} (hμ : μ ∈ (q ell).support) :
    ∃ i j, μ = e i j ∧ projectedMixed ell i j ≠ 0 := by
  classical
  rw [mem_support_iff, q_eq, coeff_sum] at hμ
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hμ
  rw [coeff_sum] at hi
  obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hi
  rw [coeff_monomial] at hj
  by_cases h : e i j = μ
  · rw [if_pos h] at hj
    exact ⟨i, j, h.symm, hj⟩
  · rw [if_neg h] at hj
    exact absurd rfl hj

/-- **The leading monomial of `q_ℓ` is `x_ℓ y_{π ℓ}`.** -/
theorem degree_q (ell : Fin 54) : lexXY.degree (q ell) = e ell (quadraticMatching ell) := by
  apply lexXY.toSyn.injective
  apply le_antisymm
  · rw [degree_le_iff]
    intro μ hμ
    obtain ⟨i, j, rfl, hA⟩ := mem_support_q hμ
    exact e_le_of i j ell (quadraticMatching ell)
      (not_lt.mp fun hlt => hA (archived_mixed_zero_before ell i j hlt))
  · refine lexXY.le_degree ?_
    rw [mem_support_iff, coeff_q, archived_mixed_pivots]
    exact one_ne_zero

/-- **The leading coefficient of `q_ℓ` is 1.** -/
theorem monic_q (ell : Fin 54) : lexXY.Monic (q ell) := by
  rw [MonomialOrder.Monic, MonomialOrder.leadingCoeff, degree_q, coeff_q, archived_mixed_pivots]

/-- **The leading term of `q_ℓ` is `x_ℓ y_{π ℓ}`.** -/
theorem leadingTerm_q (ell : Fin 54) :
    lexXY.leadingTerm (q ell) = X (Sum.inl ell) * X (Sum.inr (quadraticMatching ell)) := by
  rw [MonomialOrder.leadingTerm, (monic_q ell).leadingCoeff_eq_one, degree_q, monomial_e, C_1,
    one_mul]

/-- **The leading monomials are pairwise coprime.** -/
theorem coprime_degree :
    ∀ l l' : Fin 54, l ≠ l' → ∀ x, lexXY.degree (q l) x = 0 ∨ lexXY.degree (q l') x = 0 := by
  intro l l' hll' x
  rw [degree_q, degree_q]
  rcases x with k | k
  · rw [e_inl, e_inl]
    by_cases h : l = k
    · right
      rw [if_neg]
      intro h'
      exact hll' (h.trans h'.symm)
    · left
      rw [if_neg h]
  · rw [e_inr, e_inr]
    by_cases h : quadraticMatching l = k
    · right
      rw [if_neg]
      intro h'
      exact hll' (quadraticMatching_bijective.1 (h.trans h'.symm))
    · left
      rw [if_neg h]

/-- **Buchberger's product criterion.** The 54 quadrics form a Gröbner basis of their ideal. -/
theorem q_isGroebnerBasis : IsGroebnerBasis lexXY (Set.range q) (Ideal.span (Set.range q)) :=
  isGroebnerBasis_of_coprime lexXY q monic_q coprime_degree

/-- **The initial ideal is generated by the 54 pairwise coprime monomials `x_ℓ y_{π ℓ}`.** -/
theorem q_initialIdeal : initialIdeal lexXY (Ideal.span (Set.range q)) =
    Ideal.span (Set.range fun l : Fin 54 => X (Sum.inl l) * X (Sum.inr (quadraticMatching l))) := by
  rw [initialIdeal_span_of_coprime lexXY q monic_q coprime_degree]
  congr 1
  ext p
  simp only [Set.mem_range, degree_q, monomial_e, C_1, one_mul]

/-- **Row 11, bundled as in the paper's sentence.** -/
theorem row11 :
    (∀ ell, lexXY.degree (q ell) = e ell (quadraticMatching ell) ∧ lexXY.Monic (q ell) ∧
      lexXY.leadingTerm (q ell) = X (Sum.inl ell) * X (Sum.inr (quadraticMatching ell))) ∧
    (∀ l l' : Fin 54, l ≠ l' → ∀ x, lexXY.degree (q l) x = 0 ∨ lexXY.degree (q l') x = 0) ∧
    IsGroebnerBasis lexXY (Set.range q) (Ideal.span (Set.range q)) ∧
    initialIdeal lexXY (Ideal.span (Set.range q)) =
      Ideal.span (Set.range fun l : Fin 54 => X (Sum.inl l) * X (Sum.inr (quadraticMatching l))) :=
  ⟨fun ell => ⟨degree_q ell, monic_q ell, leadingTerm_q ell⟩, coprime_degree, q_isGroebnerBasis,
    q_initialIdeal⟩

end Brent.Groebner.Paper
